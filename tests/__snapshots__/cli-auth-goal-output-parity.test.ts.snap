exports[`hippo goal (in process) > prints the same bytes and exit codes and leaves the same rows 1`] = `
"$ goal (no sub) -> 1
--- stdout
--- stderr
Usage: hippo goal <push|list|complete|suspend|resume> [args]

$ goal bogus -> 1
--- stdout
--- stderr
Unknown goal subcommand: bogus. Expected: push | list | complete | suspend | resume.

$ goal push (no name) -> 1
--- stdout
--- stderr
Usage: hippo goal push <name> [--policy <type>] [--success "<condition>"] [--level N] [--parent <goalId>]

$ goal push (no session) -> 1
--- stdout
--- stderr
session id required (set HIPPO_SESSION_ID or pass --session-id)

$ goal push (valueless policy) -> 1
--- stdout
--- stderr
--policy requires a value (e.g., --policy error-prioritized)

$ goal push (bad policy) -> 1
--- stdout
--- stderr
Unknown --policy 'fastest'. Expected one of: schema-fit-biased | error-prioritized | recency-first | hybrid.

$ goal push (valueless success) -> 1
--- stdout
--- stderr
--success requires a value (e.g., --success "<condition>")

$ goal push (bad level) -> 1
--- stdout
--- stderr
--level must be an integer in [0, 2]

$ goal push (valueless parent) -> 1
--- stdout
--- stderr
--parent requires a value (e.g., --parent <goalId>)

$ goal push -> 0
--- stdout
id#1
--- stderr

$ goal push (control chars, parent) -> 0
--- stdout
id#2
--- stderr
note: stripped control characters from goal name

$ goal push (other tenant) -> 0
--- stdout
id#3
--- stderr

$ goal push (session from env) -> 0
--- stdout
id#4
--- stderr

$ goal list (empty session) -> 0
--- stdout
(no goals)
--- stderr

$ goal list -> 0
--- stdout
id                  status  name              outcome
id#1  active  ship the release  -      
id#2  active  fix?[31m ci       -      
id#4  active  write docs        -      
--- stderr

$ goal complete (no id) -> 1
--- stdout
--- stderr
Usage: hippo goal complete <id> [--outcome <0..1>] [--no-propagate]

$ goal complete (valueless outcome) -> 1
--- stdout
--- stderr
--outcome requires a value (e.g., --outcome 0.9)

$ goal complete (bad outcome) -> 1
--- stdout
--- stderr
--outcome must be a number in [0, 1]

$ goal complete -> 0
--- stdout
ok
--- stderr

$ goal complete (again) -> 0
--- stdout
ok
--- stderr

$ goal suspend (no id) -> 1
--- stdout
--- stderr
Usage: hippo goal suspend <id>

$ goal suspend -> 0
--- stdout
ok
--- stderr

$ goal list (suspended hidden) -> 0
--- stdout
id                  status  name              outcome
id#1  active  ship the release  -      
--- stderr

$ goal list --all -> 0
--- stdout
id                  status     name              outcome
id#1  active     ship the release  -      
id#2  completed  fix?[31m ci       0.9    
id#4  suspended  write docs        -      
--- stderr

$ goal resume (no id) -> 1
--- stdout
--- stderr
Usage: hippo goal resume <id>

$ goal resume -> 0
--- stdout
ok
--- stderr

$ goal complete --no-propagate -> 0
--- stdout
ok
--- stderr

$ goal list --all (after) -> 0
--- stdout
id                  status     name              outcome
id#1  completed  ship the release  0.5    
id#2  completed  fix?[31m ci       0.9    
id#4  active     write docs        -      
--- stderr

$ goal list --tenant-id acme -> 0
--- stdout
id                  status  name       outcome
id#3  active  acme goal  -      
--- stderr
"
`;

