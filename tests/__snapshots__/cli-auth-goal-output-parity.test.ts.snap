// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`hippo auth revoke, grant and ungrant (in process) > prints the same bytes and exit codes and leaves the same rows 1`] = `
"$ auth revoke (no id) -> 1
--- stdout
--- stderr
Usage: hippo auth revoke <key_id>

$ auth revoke (unknown) -> 1
--- stdout
--- stderr
Unknown key_id: key#4

$ auth grant (no scope) -> 1
--- stdout
--- stderr
Usage: hippo auth grant <key_id> <scope>

$ auth grant (unknown) -> 1
--- stdout
--- stderr
Unknown key_id: key#4

$ auth grant (open scope) -> 1
--- stdout
--- stderr
Error: team:eng is not a restricted scope; it is already readable by default

$ auth grant -> 0
--- stdout
Granted key#3 read access to unknown:legacy
--- stderr

$ auth grant --json (again) -> 0
--- stdout
{"keyId":"key#3","scope":"unknown:legacy","granted":true}
--- stderr

$ auth ungrant -> 0
--- stdout
Removed key#3's grant on unknown:legacy
--- stderr

$ auth ungrant --json (none held) -> 0
--- stdout
{"keyId":"key#3","scope":"unknown:legacy","granted":false}
--- stderr

$ auth revoke (other tenant) -> 0
--- stdout
Revoked key#2 at <ts>
--- stderr

$ auth revoke --json (again) -> 0
--- stdout
{"keyId":"key#2","revokedAt":"<ts>"}
--- stderr

$ auth grant (revoked) -> 1
--- stdout
--- stderr
Error: key#2 is revoked; a grant on it would never apply

$ auth revoke (own tenant) -> 0
--- stdout
{"keyId":"key#1","revokedAt":"<ts>"}
--- stderr
"
`;

