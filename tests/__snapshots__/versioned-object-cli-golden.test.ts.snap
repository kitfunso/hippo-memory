// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`versioned object CLI verbs > hippo brief: every subcommand prints the same bytes and exit code 1`] = `
"$ brief list -> 0
--- stdout
No project briefs.
--- stderr

$ brief new -> 1
--- stdout
--- stderr
Usage: hippo brief new "<repo>" --summary "<text>"
       hippo brief list [--status active|superseded|closed|all] [--repo "<repo>"] [--limit N]
       hippo brief get <id>
       hippo brief supersede <id> --summary "<text>" [--change "<summary>"]
       hippo brief close <id>
       hippo brief refresh "<repo>" [--dry-run]   (auto-assemble the brief from the repo's receipts)

$ brief new acme/web --summary Storefront app -> 0
--- stdout
Project brief recorded: #1 (v1) for repo "acme/web"
  memory: <mem>
--- stderr

$ brief acme/api --summary Orders service -> 0
--- stdout
Project brief recorded: #2 (v1) for repo "acme/api"
  memory: <mem>
--- stderr

$ brief supersede -> 1
--- stdout
--- stderr
Usage: hippo brief supersede <id> --summary "<text>" [--change "<summary>"]

$ brief supersede 1 -> 1
--- stdout
--- stderr
hippo brief supersede requires --summary "<text>" for the new version.

$ brief supersede 9999 --summary Storefront and admin app -> 1
--- stdout
--- stderr
Project brief 9999 not found.

$ brief supersede 1 --summary Storefront and admin app --change tightened -> 0
--- stdout
Project brief #3 recorded (v2), superseding #1.
  memory: <mem>
--- stderr

$ brief supersede 1 --summary Storefront and admin app -> 1
--- stdout
--- stderr
saveProjectBrief: brief 1 is not active (status='superseded'); only active briefs can be superseded.

$ brief list -> 0
--- stdout
Found 3 project briefs:

#3 [active] v2 repo="acme/web" memory=<mem>
    change: tightened
#2 [active] v1 repo="acme/api" memory=<mem>
#1 [superseded] v1 repo="acme/web" memory=<mem>
--- stderr

$ brief list --status superseded -> 0
--- stdout
Found 1 project briefs:

#1 [superseded] v1 repo="acme/web" memory=<mem>
--- stderr

$ brief get 3 -> 0
--- stdout
Project brief #3
  repo: acme/web
  status: active
  version: 2
  summary: Storefront and admin app
  change_summary: tightened
  memory: <mem>
  created: <ts>
--- stderr

$ brief get 9999 -> 1
--- stdout
--- stderr
Project brief 9999 not found.

$ brief close 3 -> 0
--- stdout
Project brief #3 closed.
--- stderr

$ brief new acme/ops -> 1
--- stdout
--- stderr
Usage: hippo brief new "<repo>" --summary "<text>"
       hippo brief list [--status active|superseded|closed|all] [--repo "<repo>"] [--limit N]
       hippo brief get <id>
       hippo brief supersede <id> --summary "<text>" [--change "<summary>"]
       hippo brief close <id>
       hippo brief refresh "<repo>" [--dry-run]   (auto-assemble the brief from the repo's receipts)
"
`;

