---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';

const title = 'hippo quickstart: memory for Claude Code, Cursor and MCP';
const description =
  'Install hippo in two commands: persistent local memory for Claude Code, Codex, Cursor, OpenClaw, OpenCode and Pi, plus an MCP server for other clients.';

// What hippo init patches per agent: README "Framework Integrations".
const integrations = [
  { name: 'Claude Code', href: '/claude-code/', note: 'A block in CLAUDE.md plus hooks: pinned memories plus the five most recent ones each turn, sleep on exit, a snapshot and the memories a compaction lists, failed tool calls stored as errors.' },
  { name: 'Cursor', href: '/cursor/', note: "A block in the project's AGENTS.md, which Cursor reads; the MCP server gives the agent the memory tools." },
  { name: 'Codex', href: '/codex/', note: 'A block in AGENTS.md plus a hook that sends pinned memories plus the five most recent ones with each prompt, once you trust it in /hooks. hippo hook install codex wraps the Codex launcher to capture sessions.' },
  { name: 'OpenClaw', note: 'A native plugin that injects context and, with autoSleep on, runs sleep when the session ends.' },
  { name: 'OpenCode', note: 'A block in AGENTS.md plus a TypeScript plugin that runs when a session starts and goes idle.' },
  { name: 'Pi', note: 'A block in AGENTS.md; copy the Pi extension from the repo for session hooks.' },
  { name: 'Any MCP client', href: '/mcp/', note: 'hippo mcp serves 13 tools over stdio to Windsurf (now Devin Desktop), Cline, Claude Desktop and others.' },
];

// Hero "at a glance" card: mirrors the page's real steps (and the HowTo JSON-LD below).
const heroSteps = [
  { n: '01', label: 'Install', cmd: site.installCmd, prompt: true },
  { n: '02', label: 'Initialize', cmd: 'hippo init', prompt: true },
  { n: '03', label: 'Use the loop', cmd: 'remember · recall · outcome · sleep', prompt: false },
];

const loop = [
  { cmd: 'hippo remember "deploy failed: forgot migrations" --error', note: 'Store a memory. Errors get a longer half-life and stick.' },
  { cmd: 'hippo recall "why did the deploy break" --budget 2000', note: 'Retrieve within a token budget that counts the whole printed block, ranked by relevance and strength.' },
  { cmd: 'hippo outcome --good', note: 'Tell hippo the recall helped. Useful memories decay slower.' },
  { cmd: 'hippo sleep', note: 'Merge related episodes, decay the unused, flag conflicts.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'Add persistent memory to an AI agent with hippo',
  description,
  step: [
    { '@type': 'HowToStep', name: 'Install', text: site.installCmd },
    { '@type': 'HowToStep', name: 'Initialize', text: "Run hippo init in one project. It creates the project's .hippo store and adds hippo's instructions to the CLAUDE.md or AGENTS.md already there. On your machine it adds Claude Code hooks or the OpenCode plugin when the project uses them, and a daily 6:15am run." },
    { '@type': 'HowToStep', name: 'Use the loop', text: 'hippo remember, hippo recall, hippo outcome and hippo sleep form the memory loop.' },
  ],
};
---

<Base title={title} description={description} crumb="Quickstart" schema={[howTo]}>
  <Nav />
  <main id="main">
    <section class="relative scroll-mt-20">
      <div class="mx-auto flex max-w-6xl items-start justify-between gap-10 px-5 pb-12 pt-28 sm:pt-32">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Quickstart</p>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-[1.03] tracking-tight sm:text-5xl">
            Add memory in <span class="text-gradient">two commands</span>.
          </h1>
          <p class="mt-5 max-w-2xl leading-relaxed text-zinc-400">
            hippo is an MIT-licensed npm package with zero runtime dependencies. Install it, run <code>hippo init</code> in a project, and it installs hooks for Claude Code and OpenCode, adds 2 hooks to Codex's <code>hooks.json</code> when Codex is installed, and adds instructions to an existing <code>AGENTS.md</code> for Codex, Cursor, OpenClaw and Pi.
          </p>
        </div>
        <!-- Setup-at-a-glance card fills the hero's right side on wide viewports. -->
        <aside class="hidden w-[19rem] shrink-0 rounded-2xl border border-white/8 bg-term-bg p-5 lg:block" aria-label="Setup at a glance: 3 steps, about 2 minutes">
          <p class="border-b border-white/5 pb-3 font-mono text-xs uppercase tracking-wider text-acc-cyan">3 steps &middot; ~2 minutes</p>
          <ol class="mt-4 space-y-3.5">
            {heroSteps.map((step) => (
              <li class="grid grid-cols-[1.5rem_1fr] gap-x-2">
                <span class="font-mono text-xs leading-6 text-acc-cyan" aria-hidden="true">{step.n}</span>
                <span class="text-sm font-medium text-zinc-200">{step.label}</span>
                <code class="col-start-2 mt-0.5 overflow-hidden text-ellipsis whitespace-nowrap font-mono text-xs text-zinc-400">{step.prompt ? <><span class="text-term-prompt">$</span> {step.cmd}</> : step.cmd}</code>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <section class="relative scroll-mt-20 border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-3xl leading-tight sm:text-4xl">Install</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-400">
          Run <code class="rounded bg-white/[0.04] px-1.5 py-0.5 font-mono text-zinc-300">hippo init</code> inside one project. It creates a <code>.hippo/</code> store there, seeded on the first run from the last 30 days of git history and the project's Claude Code auto memory, and adds hippo's instructions to the <code>CLAUDE.md</code> or <code>AGENTS.md</code> already there (Codex, Cursor, OpenClaw, OpenCode and Pi read <code>AGENTS.md</code>); it never creates either file. On your machine it adds 7 Claude Code hook entries to <code>~/.claude/settings.json</code>, or the OpenCode plugin, when the project uses them; 2 hook entries in Codex's <code>hooks.json</code> when the project has <code>AGENTS.md</code> or a <code>.codex</code> folder and Codex is installed, which Codex runs once you trust them in <code>/hooks</code>; and a daily 6:15am run: a crontab line on Linux and macOS, a scheduled task on Windows. <code>--no-hooks</code>, <code>--no-schedule</code> and <code>--no-learn</code> leave those parts out; <a class="link" href={`${site.links.repo}#what-hippo-init-changes`}>What hippo init changes</a> has the full list.
        </p>
        <pre class="mt-6 overflow-x-auto rounded-2xl border border-white/8 bg-term-bg p-5 font-mono text-sm leading-relaxed text-term-fg"><code><span class="text-term-prompt">$</span> {site.installCmd}
<span class="text-term-prompt">$</span> {site.initCmd}</code></pre>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-400">
          Setting up many repos at once is a second step, so know what it changes first. Every git repo in your home folder and up to three levels below it gets a store of its own, seeded from a year of its commits, plus the same user-level hooks and daily run; no <code>CLAUDE.md</code> or <code>AGENTS.md</code> is patched. The command is <code class="rounded bg-white/[0.04] px-1.5 py-0.5 font-mono text-zinc-300">{site.scanCmd}</code>.
        </p>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
          Memories are stored in SQLite with markdown mirrors, and recall makes no network call by default. No account.
          <a class="link" href="/faq/#where-does-hippo-keep-my-data">Where hippo keeps your data</a> lists the opt-in features that send text to a provider.
        </p>
      </div>
    </section>

    <section class="relative scroll-mt-20 border-t border-white/5">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-3xl leading-tight sm:text-4xl">Works with your agents</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {integrations.map((i) => (
            <div class="glass rounded-2xl p-5">
              {i.href
                ? <a href={i.href} class="link text-sm font-medium">{i.name}</a>
                : <span class="text-sm font-medium text-zinc-200">{i.name}</span>}
              <span class="mt-2 block text-xs leading-relaxed text-zinc-400">{i.note}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="relative scroll-mt-20 border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-3xl leading-tight sm:text-4xl">The memory loop</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          Four commands. Memories decay on a half-life unless something keeps them alive: a retrieval, a good outcome, an error tag, or consolidation during sleep.
        </p>
        <div class="mt-8 space-y-3">
          {loop.map((step) => (
            <div class="rounded-2xl border border-white/8 p-5">
              <code class="block overflow-x-auto font-mono text-sm text-zinc-200"><span class="text-term-prompt">$</span> {step.cmd}</code>
              <span class="mt-2 block text-xs leading-relaxed text-zinc-400">{step.note}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.links.docs} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-zinc-100 px-5 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-white">Full docs<span class="sr-only"> (opens in new tab)</span></a>
          <a href="/benchmarks/" class="rounded-lg border border-white/12 px-5 py-2.5 text-sm font-medium text-zinc-200 transition hover:border-white/25">See the benchmarks</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
