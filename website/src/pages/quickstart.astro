---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cmd from '../components/Cmd.astro';
import CopyButton from '../components/CopyButton.astro';
import PageIntro from '../components/PageIntro.astro';
import { getStarted, site } from '../content/site';

const title = 'hippo quickstart: two commands';
const description =
  'Install hippo-memory from npm and run hippo init in a project. It needs Node 22.16 or later, no account and no API key, and it stores memories in SQLite on your machine.';

const loop = [
  { cmd: 'hippo remember "deploy failed: forgot migrations" --error', note: 'Stores a memory. Errors get twice the half-life.' },
  { cmd: 'hippo recall "why did the deploy break" --budget 2000', note: 'Returns the matches that fit a token budget.' },
  { cmd: 'hippo outcome --good', note: 'Marks the last recall as useful.' },
  { cmd: 'hippo sleep', note: 'Merges related memories and lets unused ones fade.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'Add persistent memory to an AI agent with hippo',
  description,
  step: [
    { '@type': 'HowToStep', name: 'Install', text: site.installCmd },
    { '@type': 'HowToStep', name: 'Initialize', text: "Run hippo init in a project. It creates a .hippo store, adds a short block to an existing CLAUDE.md or AGENTS.md, installs Claude Code's hooks and schedules a daily run." },
    { '@type': 'HowToStep', name: 'Run the four commands', text: 'hippo remember, hippo recall, hippo outcome and hippo sleep store, return, mark and merge memories.' },
  ],
};
---

<Base title={title} description={description} crumb="Quickstart" schema={[howTo]}>
  <Nav />
  <main id="main">
    <PageIntro>
      <Fragment slot="title">Two commands, then carry on working</Fragment>
      <p>Hippo is an MIT-licensed npm package with zero runtime dependencies. It needs Node 22.16 or later, no account and no API key.</p>
    </PageIntro>

    <section id="install" class="relative border-t border-rule bg-paper-3">
      <div class="wrap py-(--section-y)">
        <div><Cmd lines={[site.installCmd, 'hippo init']} copy /></div>
        <p class="mt-4 text-sm leading-relaxed text-ink-2">
          <code class="rounded bg-paper-3 px-1.5 py-0.5 font-mono text-ink-2">hippo init</code> creates a <code>.hippo/</code> store in the project, adds a short block to an existing <code>CLAUDE.md</code> or <code>AGENTS.md</code>, installs Claude Code's hooks and schedules a daily run at 6:15am that stores lessons from the day's commits. <code>--no-hooks</code> and <code>--no-schedule</code> skip those parts. <code class="rounded bg-paper-3 px-1.5 py-0.5 font-mono text-ink-2">hippo init --scan ~</code> gives every git repository under your home folder a store.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink-2">
          {getStarted.notice} Codex runs hippo's hooks only once you trust them in <code>/hooks</code>. <code>hippo doctor</code> checks the install.
        </p>
      </div>
    </section>

    <section id="works-with-your-agents" class="relative border-t border-rule">
      <div class="wrap py-(--section-y)">
        <h2>What each agent gets</h2>
        <p class="mt-4 leading-relaxed text-ink-2">
          Claude Code gets a block in <code>CLAUDE.md</code> and eight hooks. Codex gets a block in <code>AGENTS.md</code> and two hooks. Cursor and Pi read the <code>AGENTS.md</code> block, OpenClaw and OpenCode use a plugin, and any MCP client can run <code>hippo mcp</code>.
        </p>
      </div>
    </section>

    <section id="the-memory-loop" class="relative border-t border-rule bg-paper-3">
      <div class="wrap py-(--section-y)">
        <h2>Four commands you can run yourself</h2>
        <div class="mt-8 space-y-3">
          {loop.map((step) => (
            <div class="rounded-xl border border-rule p-5">
              <div class="flex items-start gap-3">
                <code class="block min-w-0 flex-1 overflow-x-auto font-mono text-sm text-ink" data-scroll-x><span class="select-none text-accent">$</span> {step.cmd}</code>
                <CopyButton text={step.cmd} label={`Copy command: ${step.cmd}`} />
              </div>
              <span class="mt-2 block text-xs leading-relaxed text-ink-2">{step.note}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.links.docs} target="_blank" rel="noopener noreferrer" class="btn">Full docs<span class="sr-only"> (opens in new tab)</span></a>
          <a href="/benchmarks/" class="btn-quiet">See the benchmarks</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
