---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GetStarted from '../components/GetStarted.astro';
import LocalFirst from '../components/LocalFirst.astro';
import Receipts from '../components/Receipts.astro';
import Compare from '../components/Compare.astro';
import Faq from '../components/Faq.astro';
import InstallCta from '../components/InstallCta.astro';
import Footer from '../components/Footer.astro';
import { faqPick } from '../content/site';

// Homepage-only meta + OG description, carrying the terms people actually search:
// "open-source", "local-first" and "MCP server". The shared site.description (JSON-LD
// and every other page) and the visible hero copy are left unchanged on purpose.
const metaDescription =
  'Open-source, local-first memory for AI agents, with an MCP server. A memory marked wrong drops out of the top results, and newer facts supersede old ones.';

// The home FAQ is a sample; /faq/ holds every question and the FAQPage markup.
const homeFaq = faqPick([
  'Is this just RAG?',
  'Which agents does hippo work with?',
  'Where does hippo keep my data?',
  'How is hippo different from mem0?',
  'What happens when a memory turns out to be wrong?',
  'Has hippo been shown to make agents better at their work?',
]);
---

<Base description={metaDescription}>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <HowItWorks />
    <GetStarted />
    <LocalFirst />
    <Receipts />
    <Compare />
    <Faq items={homeFaq} moreHref="/faq/" />
    <InstallCta />
  </main>
  <Footer />
</Base>
