---
// Home page in the Lagoon design. Fonts, three.js and GSAP are bundled, so the page loads nothing from a CDN.
import '@fontsource/schibsted-grotesk/latin-600.css';
import '@fontsource/schibsted-grotesk/latin-700.css';
import '@fontsource/schibsted-grotesk/latin-800.css';
import '@fontsource/schibsted-grotesk/latin-900.css';
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/spline-sans-mono/latin-400.css';
import '@fontsource/spline-sans-mono/latin-500.css';
import '@fontsource/spline-sans-mono/latin-600.css';
import '../styles/home.css';
import Head from '../components/Head.astro';
import Beacon from '../components/Beacon.astro';
import { site } from '../content/site';
import board from '../data/all-benchmarks.json';

interface Rival { name: string; value: string; num: number; system: string | null; model: string; url: string }
interface BoardRow { name: string; task: string; tag: string; caveat: string | null; hippo: { value: string | null; num: number | null; setting: string | null; status: string | null }; rivals: readonly Rival[] }
// hippo's official-setup rows, then each published setup with 7+ rivals that hippo has not run (hippo-bench MIN_RIVALS).
const boardRows: readonly BoardRow[] = [...board.official, ...board.published];
// Only the large products get a column (hippo-bench LARGE); the rank and the best box still count every published score.
const boardCols: readonly string[] = board.homeColumns;
const metaOf = (x: Rival) => [x.system, x.model].filter(Boolean).join(' · ');
// Odd items are hyphenated words such as gpt-4o-mini; the template keeps each short one on one line, so Qwen3-235B-A22B can wrap.
const byHyphen = (t: string | null) => (t ?? '').split(/(\S+-\S+)/);
const topOf = (r: BoardRow) => Math.max(r.hippo.num ?? -Infinity, ...r.rivals.map((x) => x.num));
const rankOf = (r: BoardRow) => {
  const k = 1 + r.rivals.filter((x) => x.num > (r.hippo.num ?? 0)).length;
  return `${['1st', '2nd', '3rd'][k - 1] ?? `${k}th`} of ${r.rivals.length + 1}`;
};
// The row's top score when no column shows it, so a rank like "2nd of 4" or a "not run" row names who is 1st.
const leadOf = (r: BoardRow) => r.rivals.find((x) => x.num === topOf(r) && x.num > (r.hippo.num ?? -Infinity) && !boardCols.includes(x.name));
const tagHead = (t: string) => t.split(', ')[0];

const title = "hippo: one memory for every agent you'll ever use";
const description = 'hippo writes what you teach a coding agent into a store in your repo, and your other agents read that same store.';
---

