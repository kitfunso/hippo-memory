<!-- page behaviour, no imports, so it runs even if the 3D module fails -->
<script is:inline>
(function () {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (s, r = document) => r.querySelector(s);
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  // Mobile menu
  const menu = $('.menu'), links = $('#links');
  menu.addEventListener('click', () => { const open = links.classList.toggle('open'); menu.setAttribute('aria-expanded', String(open)); });
  links.addEventListener('click', (e) => { if (e.target.closest('a')) { links.classList.remove('open'); menu.setAttribute('aria-expanded', 'false'); } });

  // Sample store: made-up memories except the first two, which come from the demo store's real recall output.
  const STORE = [
    { id: 'mem_8e4ca54dcb2c', kind: 'error', tags: 'error, path:payments-api', st: 1, ret: 2, text: 'deploy failed: forgot to run migrations before the deploy' },
    { id: 'mem_22f16003d809', kind: 'rule', pinned: true, tags: 'rule, path:payments-api', st: 1, ret: 2, text: 'run the migration before the deploy, the release script does not run it for you' },
    { id: 'mem_4c1e9a07b2d3', kind: 'rule', pinned: true, tags: 'rule, path:payments-api', st: 1, ret: 6, text: 'never log access tokens, mask them before anything reaches the logger' },
    { id: 'mem_1fd6a3b0c912', kind: 'rule', pinned: true, tags: 'rule, path:payments-api', st: 1, ret: 3, text: 'integration tests must hit the real database, never a mock, a mock hid a bug in the billing query' },
    { id: 'mem_7e03c5d1a6f2', kind: 'rule', pinned: true, tags: 'rule, path:payments-api', st: 1, ret: 4, text: 'the payments retry is already idempotent, do not wrap it in a second retry' },
    { id: 'mem_c40a9e7d2b61', kind: 'lesson', tags: 'path:payments-api', st: 0.9, ret: 2, text: 'staging and production use different env files, staging reads .env.staging' },
    { id: 'mem_5f2b1c8e93a0', kind: 'decision', tags: 'decision, path:payments-api', st: 0.7, ret: 1, text: 'API v1 is deprecated, new endpoints go under /v2' },
    { id: 'mem_e6a4d02f7c39', kind: 'error', tags: 'error, path:payments-api', st: 0.9, ret: 1, text: 'make e2e fails on a cold cache, read the browser log before you retry it' },
    { id: 'mem_0b9f6e3a1d58', kind: 'decision', tags: 'decision, path:payments-api', st: 0.6, ret: 1, text: 'design review agreed: buttons use sentence case, one primary action per screen' },
    { id: 'mem_8c71d4b2e0a9', kind: 'lesson', tags: 'path:payments-api', st: 0.8, ret: 1, text: 'the deploy script reads DATABASE_URL from the env file, so the wrong env file deploys to the wrong database' },
    { id: 'mem_2a5e9c03f6d4', kind: 'lesson', tags: 'path:payments-api', st: 0.8, ret: 1, text: 'payments webhooks can arrive out of order, store the event id and drop duplicates' },
    { id: 'mem_6d0f3b7a8e12', kind: 'error', tags: 'error, path:payments-api', st: 1, ret: 1, text: 'retrying the payments call by hand charged a test card twice, the retry belongs in the client' },
  ];
  const STOP = new Set(['the', 'a', 'an', 'to', 'of', 'in', 'on', 'and', 'or', 'is', 'it', 'for', 'i', 'can', 'do', 'does', 'use', 'so', 'by', 'you', 'what', 'which', 'why', 'did']);
  const tokenize = (t) => t.toLowerCase().replace(/[^\w\s]/g, ' ').split(/\s+/).filter((w) => w.length > 1 && !STOP.has(w));
  function search(query) {
    const q = [...new Set(tokenize(query))];
    const docs = STORE.map((m) => tokenize(m.text));
    const N = docs.length, avg = docs.reduce((a, d) => a + d.length, 0) / N, df = new Map();
    docs.forEach((d) => new Set(d).forEach((t) => df.set(t, (df.get(t) || 0) + 1)));
    return STORE.map((m, i) => {
      const tf = new Map(); docs[i].forEach((t) => tf.set(t, (tf.get(t) || 0) + 1));
      let score = 0; const hit = [];
      for (const t of q) {
        const f = tf.get(t) || 0; if (!f) continue;
        hit.push(t);
        const n = df.get(t), idf = Math.log((N - n + 0.5) / (n + 0.5) + 1);
        score += idf * (f * 2.2) / (f + 1.2 * (0.25 + 0.75 * docs[i].length / avg));
      }
      return { m, score, hit };
    }).filter((r) => r.score > 0).sort((a, b) => b.score - a.score);
  }
  const hl = (text, hits) => { const set = new Set(hits); return text.split(/(\w+)/).map((p, i) => (i % 2 && set.has(p.toLowerCase()) ? `<mark>${esc(p)}</mark>` : esc(p))).join(''); };
  const bar = (st) => '█'.repeat(Math.round(st * 10)).padEnd(10, ' ');

  const q = $('#q'), out = $('#out');
  function renderStore(hits) {
    $('#store').innerHTML = STORE.map((m) => { const h = hits.get(m.id); return `<li class="${h ? 'hit' : ''}"><span class="k ${m.kind}"></span><span class="t">${h ? hl(m.text, h.hit) : esc(m.text)}</span></li>`; }).join('');
    $('#store-n').textContent = `${STORE.length} memories`;
  }
  const sessionBlock = (fresh) => `<span class="h">## Rules from the user</span>\n` + STORE.filter((m) => m.pinned).map((m) => `<span class="${m.id === fresh ? 'new' : ''}">- ${esc(m.text)}</span>`).join('\n');
  function run() {
    const query = q.value.trim();
    const res = query ? search(query) : [];
    renderStore(new Map(res.map((r) => [r.m.id, r])));
    if (!query) { out.innerHTML = '<span class="w">Type a question your agent might ask.</span>'; $('#adds').innerHTML = ''; $('#adds-n').textContent = ''; return; }
    const tokens = res.reduce((a, r) => a + Math.ceil(r.m.text.length / 4) + 28, 0);
    let s = `<span class="ps">$ hippo recall "${esc(query)}" --why</span>\n`;
    if (!res.length) s += `No memories share a word with that yet. Try deploy, payments or database.`;
    else {
      s += `Found ${res.length} memories (${tokens} tokens) for: "${esc(query)}"\n`;
      s += res.map((r) => `\n<span class="h">--- ${r.m.id} [episodic] [verified] score=${r.score.toFixed(3)} strength=${r.m.st.toFixed(2)}</span>\n    [${bar(r.m.st)}] tags: ${r.m.tags} | retrieved: ${r.m.ret}x\n    <span class="w">reason: matched terms [${r.hit.join(', ')}]</span>\n\n<span class="tx">${hl(r.m.text, r.hit)}</span>\n`).join('');
    }
    out.innerHTML = s;
    const extra = res.filter((r) => !r.m.pinned).slice(0, 5);
    $('#adds-n').textContent = `${extra.length} of up to 5`;
    $('#adds').innerHTML = extra.map((r) => `<li><span class="id">${r.m.id}</span><br>${hl(r.m.text, r.hit)}</li>`).join('') || '<li>Pinned rules only.</li>';
  }
  let typing = null;
  function typeInto(text) {
    clearInterval(typing);
    if (reduce) { q.value = text; run(); return; }
    q.value = ''; let i = 0;
    typing = setInterval(() => { q.value = text.slice(0, ++i); run(); if (i >= text.length) clearInterval(typing); }, 55);
  }
  q.addEventListener('input', () => { clearInterval(typing); run(); });
  q.addEventListener('focus', () => clearInterval(typing));
  $('#examples').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) typeInto(b.textContent.trim()); });
  $('#sess').innerHTML = sessionBlock();
  run();
  let typed = false;
  new IntersectionObserver((es, ob) => { if (es[0].isIntersecting && !typed) { typed = true; ob.disconnect(); setTimeout(() => typeInto('deploy migrations'), reduce ? 0 : 300); } }, { threshold: 0.25 }).observe($('#demo'));

  // Tell it once: the rule-word check hippo runs when a session ends.
  const said = $('#said'), log = $('#log');
  said.value = 'never commit the .env.production file';
  let n = 0;
  function endSession() {
    const text = said.value.trim();
    if (!text) { log.textContent = 'Type a correction first.'; return; }
    const word = (text.match(/\b(never|always|must)\b/i) || [])[1];
    if (!word) { log.textContent = `SessionEnd: no rule word found, so this can be missed.\nPin it by hand: hippo remember "${text}" --pin`; $('#sess2').innerHTML = sessionBlock(); return; }
    const id = 'mem_' + (0xa0b1c2d3e4f5 + (++n) * 7919).toString(16).slice(-12);
    STORE.push({ id, kind: 'rule', pinned: true, tags: 'rule, path:payments-api', st: 1, ret: 0, text });
    log.textContent = `SessionEnd: rule word "${word.toLowerCase()}" found\npinned as ${id}\nIn the next session, and in Recall.`;
    $('#sess2').innerHTML = sessionBlock(id);
    $('#sess').innerHTML = sessionBlock();
    picked = id; renderFiles(); run();
  }
  $('#endsess').addEventListener('click', endSession);
  $('#tell-ex').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) { said.value = b.textContent.trim(); endSession(); } });
  $('#sess2').innerHTML = sessionBlock();
  log.textContent = 'Press End the session to run the check.';

  // On disk: each memory's markdown mirror.
  let picked = STORE[1].id;
  function renderFiles() {
    $('#files').innerHTML = STORE.map((m) => `<li><button type="button" aria-pressed="${m.id === picked}" data-id="${m.id}">${m.id}.md</button></li>`).join('');
    const m = STORE.find((x) => x.id === picked);
    $('#fpath').textContent = `.hippo/episodic/${m.id}.md`;
    $('#fbody').innerHTML = `<span class="fm">---\nid: ${m.id}\nlayer: episodic\ntags: [${m.tags}]\nhalf_life_days: ${m.kind === 'error' ? 730 : 365}\npinned: ${!!m.pinned}\nstrength: ${m.st.toFixed(2)}\n---</span>\n\n${esc(m.text)}`;
  }
  $('#files').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) { picked = b.dataset.id; renderFiles(); } });
  renderFiles();

  // Tabs
  const tabs = [...document.querySelectorAll('[role="tab"]')];
  function select(t, focus) {
    tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; $('#' + x.getAttribute('aria-controls')).hidden = !on; });
    if (focus) t.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t, true));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length], true);
      if (e.key === 'ArrowLeft') select(tabs[(i + tabs.length - 1) % tabs.length], true);
    });
  });

  // Copy buttons
  const PROMPT = $('#prompt-text').textContent.trim();
  document.querySelectorAll('.copy').forEach((b) => b.addEventListener('click', async () => {
    const text = b.dataset.copy === 'prompt' ? PROMPT : b.dataset.copy;
    try { await navigator.clipboard.writeText(text); }
    catch (err) {
      const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
      console.warn('hippo: clipboard API blocked, used the fallback copy', err);
    }
    const l = b.querySelector('.lbl');
    if (l) { const old = l.textContent; l.textContent = 'Copied'; b.classList.add('done'); setTimeout(() => { l.textContent = old; b.classList.remove('done'); }, 1600); }
    else { const old = b.textContent; b.textContent = 'Copied'; setTimeout(() => { b.textContent = old; }, 1600); }
  }));

  // Floating command rows
  const ROWS = [
    ['hippo init', 'hippo recall "why did the deploy break" --why', 'hippo remember "never log access tokens" --pin', 'hippo outcome --good', 'hippo doctor', 'hippo init --scan ~', 'hippo dashboard'],
    ['hippo outcome --bad', 'hippo supersede mem_a1b2c3 "billing moved to bun"', 'hippo recall "payments retry" --budget 2000', 'hippo sleep', 'hippo mcp', 'hippo init --no-schedule'],
    ['hippo remember "deploy failed: forgot migrations" --error', 'hippo forget <id>', 'hippo dormant restore <id>', 'hippo init --no-hooks', 'hippo recall "staging env file" --why'],
  ];
  ROWS.forEach((row, i) => {
    const html = row.map((c) => `<code><b>${esc(c.split(' ')[0])}</b> ${esc(c.split(' ').slice(1).join(' '))}</code>`).join('');
    $('#mq' + (i + 1)).innerHTML = html + html;
  });

  // 100-square grids: repeats are red, shuffled with a fixed seed.
  const rng = (a) => () => { a = (a + 0x6D2B79F5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  document.querySelectorAll('.cells').forEach((el) => {
    const nRep = Number(el.dataset.n), r = rng(Number(el.dataset.seed));
    const idx = Array.from({ length: 100 }, (_, i) => i);
    for (let i = 99; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [idx[i], idx[j]] = [idx[j], idx[i]]; }
    const on = new Set(idx.slice(0, nRep)), rank = new Map(idx.map((v, k) => [v, k]));
    el.innerHTML = Array.from({ length: 100 }, (_, i) => `<i${on.has(i) ? ' class="rep"' : ''} style="transition-delay:${(reduce ? 0 : (i * 6 + (on.has(i) ? 600 + rank.get(i) * 14 : 0)))}ms"></i>`).join('');
  });

  // Reveal on scroll
  const io = new IntersectionObserver((es) => es.forEach((en) => {
    if (!en.isIntersecting) return;
    const el = en.target; io.unobserve(el);
    el.classList.add('in');
  }), { threshold: 0.2 });
  document.querySelectorAll('.rv, .float, .cells').forEach((el) => io.observe(el));

  // Film captions light up while they sit in the middle of the window.
  const capIO = new IntersectionObserver((es) => es.forEach((en) => en.target.classList.toggle('on', en.isIntersecting)), { rootMargin: '-38% 0px -38% 0px' });
  document.querySelectorAll('.stage .cap').forEach((c) => capIO.observe(c));
  // The skip link shows while film stages 1 to 7 sit in the middle of the window.
  const skip = document.querySelector('.skipfilm'), live = new Set();
  const skipIO = new IntersectionObserver((es) => { es.forEach((en) => (en.isIntersecting ? live.add(en.target) : live.delete(en.target))); skip.classList.toggle('on', live.size > 0); }, { rootMargin: '-38% 0px -38% 0px' });
  document.querySelectorAll('.stage:not(.intro):not(.tail)').forEach((s) => skipIO.observe(s));

  // Convex-style stripes that bend around a box (from 8)
  const SW = () => (innerWidth < 760 ? 11 : 16);
  function rail(svg, host, box, o, end = box) {
    const H = host.getBoundingClientRect(), B = box.getBoundingClientRect(), W = H.width, sw = SW();
    const x0 = B.right - H.left + o.dx, yA = B.top - H.top + o.dy, yB = end.getBoundingClientRect().bottom - H.top + o.db;
    svg.setAttribute('viewBox', `0 0 ${W} ${H.height}`);
    svg.innerHTML = ['#5eead4', '#22a6c9', '#2f4bb3'].map((c, i) => {
      const yc = yA + sw / 2 + i * sw, xc = x0 + sw / 2 + i * sw, ybc = yB + sw / 2 + i * sw, r1 = 14 + (2 - i) * sw, r2 = 14 + i * sw;
      return `<path d="M${W + 4} ${yc} H${xc + r1} A${r1} ${r1} 0 0 0 ${xc} ${yc + r1} V${ybc - r2} A${r2} ${r2} 0 0 1 ${xc - r2} ${ybc} H-4" fill="none" stroke="${c}" stroke-width="${sw + 0.6}"/>`;
    }).join('');
  }
  const drawRails = () => {
    rail($('#rail-try'), $('.try'), $('#demo'), innerWidth < 760 ? { dx: -60, dy: 60, db: 24 } : { dx: 26, dy: 110, db: 30 }, $('#try .quiet'));
    rail($('#rail-install'), $('.install'), $('#setupbox'), innerWidth < 760 ? { dx: -60, dy: -40, db: 64 } : { dx: 40, dy: 34, db: 110 });
  };
  new ResizeObserver(drawRails).observe(document.body);
  if (document.fonts) document.fonts.ready.then(drawRails);
  drawRails();
})();
</script>

<!-- the scene: 6's glass index cards, and 11's pinned film that follows one of them -->
<script>
// three.js and GSAP load after first paint, and the film builds only near its section: on load they blocked the main thread for 1.1 s.
const root = document.documentElement;
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
// A test context cost 350 ms on a slow phone; three.js throws on a failed context and both scenes catch that.
const glOK = 'WebGLRenderingContext' in window;
if (!glOK) root.classList.add('no-gl');
else {
  const gl = () => import('../scripts/home-gl.js');
  const idle = window.requestIdleCallback || ((f) => setTimeout(f, 200));
  const start = () => idle(() => gl().then((m) => m.hero()).catch((err) => { root.classList.add('no-gl'); console.warn('hippo: the hero scene did not load, keeping the CSS cards', err); }), { timeout: 2500 });
  if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true });
  if (!reduce) {
    // The film layout is set now so anchor jumps land where they aim; only its WebGL waits.
    root.style.setProperty('--vh', `${Math.min(innerHeight, 1600)}px`);
    root.classList.replace('static', 'gl');
    const story = document.getElementById('story');
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      gl().then((m) => m.film()).catch((err) => { root.classList.replace('gl', 'static'); console.warn('hippo: the film did not load, keeping the static stages', err); });
    }, { rootMargin: '150% 0px' }).observe(story);
  }
}
</script>
<script is:inline>
// One square per model call, from the dark journey mockup: Mem0's 5,882 calls to store LoCoMo against hippo's 0.
(() => {
  const N = 5882, cA = document.getElementById('cgA'), cB = document.getElementById('cgB'), countEl = document.getElementById('cgCount');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let shown = reduce ? N : 0, geom = null;
  const layout = () => {
    const w = cA.parentElement.clientWidth - 44, step = w < 420 ? 3 : 4, cols = Math.floor(w / step), rows = Math.ceil(N / cols), dpr = Math.min(devicePixelRatio || 1, 2);
    for (const c of [cA, cB]) { c.width = cols * step * dpr; c.height = rows * step * dpr; c.style.width = cols * step + 'px'; c.style.height = rows * step + 'px'; }
    geom = { step, cols, dpr };
  };
  const draw = () => {
    const { step, cols, dpr } = geom, s = step - 1, a = cA.getContext('2d'), b = cB.getContext('2d');
    a.setTransform(dpr, 0, 0, dpr, 0, 0); b.setTransform(dpr, 0, 0, dpr, 0, 0);
    a.clearRect(0, 0, cA.width, cA.height); b.clearRect(0, 0, cB.width, cB.height);
    b.fillStyle = 'rgba(255,255,255,0.055)';
    for (let i = 0; i < N; i++) {
      const x = (i % cols) * step, y = Math.floor(i / cols) * step;
      b.fillRect(x, y, s, s);
      a.fillStyle = i < shown ? (i % 97 === 0 ? '#b0e7f4' : '#3dbfe1') : 'rgba(255,255,255,0.055)';
      a.fillRect(x, y, s, s);
    }
  };
  layout(); draw();
  addEventListener('resize', () => { layout(); draw(); });
  if (reduce) return;
  countEl.textContent = '0';
  new IntersectionObserver((es, ob) => {
    if (!es[0].isIntersecting) return;
    ob.disconnect();
    const t0 = performance.now(), dur = 1600;
    const tick = (now) => { const p = Math.min((now - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3); shown = Math.round(N * e); countEl.textContent = shown.toLocaleString('en-GB'); draw(); if (p < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }, { threshold: 0.25 }).observe(cA);
})();
</script>
<Beacon />
</body>
</html>
