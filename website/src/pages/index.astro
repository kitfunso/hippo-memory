            {boardRows.map((r) => {
              const lead = leadOf(r);
              const first = lead && <small class="dt">1st is <a href={lead.url} target="_blank" rel="noopener noreferrer">{lead.system ?? lead.name} {lead.value}<span class="sr-only"> (published score, opens in a new tab)</span></a></small>;
