                <th scope="row"><b>{r.name}</b><small class="dt">{r.task}</small><span class:list={['kind', r.caveat && 'cav']}>{tagHead(r.tag)}<span class="dt">{r.tag.slice(tagHead(r.tag).length)}</span></span>{r.caveat && <small class="dt cv">{r.caveat}</small>}</th>
                <td class:list={['hp', !r.hippo.status && r.hippo.num === topOf(r) && 'best']}>{r.hippo.status ? <><span class="run">{r.hippo.status}</span>{first}</> : <><span class="v">{r.hippo.value}</span><small>{rankOf(r)}</small>{first}<small class="dt">{byHyphen(r.hippo.setting).map((s, i) => (i % 2 && s.length <= 13 ? <span class="nw">{s}</span> : s))}</small></>}</td>
                {boardCols.map((c) => {
                  const x = r.rivals.find((y) => y.name === c);
                  if (!x) return <td class="na">-</td>;
                  return <td class:list={[x.num === topOf(r) && 'best']}><a class="v" href={x.url} target="_blank" rel="noopener noreferrer">{x.value}<span class="sr-only"> ({x.system ?? c}, published score, opens in a new tab)</span></a>{x.system && <small class="sm">{x.system}</small>}<small class="dt">{byHyphen(metaOf(x)).map((s, i) => (i % 2 && s.length <= 13 ? <span class="nw">{s}</span> : s))}</small></td>;
                })}
              </tr>
              );
            })}
