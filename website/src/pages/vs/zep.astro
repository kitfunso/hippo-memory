---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import VsTable from '../../components/VsTable.astro';
import { REPO } from '../../content/site';
import Faq from '../../components/Faq.astro';
import { faqPageLd } from '../../content/readme';

const title = 'hippo vs Zep: a local Zep alternative';
const description =
  "hippo and Zep compared by the hippo team, features checked 28 September 2026. Zep is a managed service with a knowledge graph; hippo runs on your machine with no account. On DMR, Zep publishes 98.2 and hippo scored 73.1 in our run, on different setups.";
const rows = [
  ['Decay by default', 'Decay by default'],
  ['Retrieval strengthening', 'Recall strengthens a memory'],
  ['Outcome tracking', 'Outcome tracking'],
  ['Conflict detection + resolution', 'Conflict detection'],
  ['Schema acceleration / knowledge graph', 'Knowledge graph'],
  ['Multi-agent shared memory', 'Shared between agents'],
  ['Auto-hook install', 'Installs its own hooks'],
  ['MCP server', 'MCP server'],
  ['Zero runtime deps', 'Zero runtime dependencies'],
  ['License', 'Licence'],
] as const;

const qa = [
  {
    q: "Can I still self-host Zep?",
    a: "Not Zep itself. Zep's FAQ says Community Edition, the version you could host locally, is deprecated and no longer supported (checked 28 September 2026). Graphiti, the open-source framework under Zep, runs anywhere, and needs a graph database and a language-model key.",
  },
];
---

<Base title={title} description={description} crumb="hippo vs Zep" published="2026-09-28" schema={[faqPageLd(qa)]}>
  <Nav />
  <main id="main">
    <PageIntro>
      <Fragment slot="title">hippo vs <span class="text-ink">Zep</span></Fragment>
      <p>
        Zep is a managed context service for agents, built on Graphiti, its open-source temporal knowledge graph. Its self-hosted Community Edition is deprecated, so Zep today means Zep Cloud, or your own cloud on the Enterprise plan. Hippo runs on your machine with no account, and wires itself into the coding agents it finds.
      </p>
    </PageIntro>

    <Section title="The one test both have numbers on">
      <p>
        On DMR, a public memory test of 495 questions, Zep publishes 98.2 and hippo scored 73.1 when we ran it. The setups differ. A whole-chat baseline that is published at 98.0 scored 83.6 in our run, so the size of the gap is rough. Zep's published score is higher, and we have not run Zep under the same conditions. Zep's other published scores vary by source, so we quote none of them here.
      </p>
    </Section>

    <Section title="Feature by feature" alt>
      <p>
        The Zep column was checked against Zep's own pages on 28 September 2026. The full table is on
        <a class="link" href={`${REPO}#comparison`} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in new tab)</span></a>.
      </p>
      <VsTable system="Zep" rows={rows} />
    </Section>

    <Section title="Both keep the old fact">
      <p>
        Graphiti gives facts validity windows and invalidates old ones instead of deleting them. Hippo links a superseded memory to its replacement and leaves it out of recall, and <code>hippo recall --as-of &lt;date&gt;</code> shows what was current on a given day.
      </p>
    </Section>

    <Section title="What Zep ships today" alt>
      <p>
        Zep Cloud is the product, and Enterprise customers can run it in their own cloud. There is no self-hosted Zep, because Community Edition is deprecated and no longer supported. Graphiti is Apache-2.0 if you want to build your own, and it needs a graph database and defaults to OpenAI for inference and embeddings. Zep's MCP server is hosted and needs sign-in (<a class="link" href="https://help.getzep.com/faq" target="_blank" rel="noopener noreferrer">Zep's pages<span class="sr-only"> (opens in new tab)</span></a>, checked 28 September 2026).
      </p>
    </Section>

    <Section title="When to pick which">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-rule bg-paper-2 p-6">
          <h3 class="text-base font-medium text-ink">Pick hippo</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick hippo when the memory is for coding agents on your machine, and you want no account, graph database or model to run.
          </p>
        </div>
        <div class="rounded-xl border border-rule bg-paper-2 p-6">
          <h3 class="text-base font-medium text-ink">Pick Zep</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick Zep when you want a managed service that turns business data, documents and conversations into a knowledge graph for your agents, with someone else running it.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 pt-4">
        <a href="/quickstart/" class="btn">Get started with hippo</a>
      </div>
    </Section>

    <Faq items={qa} heading="hippo and Zep, asked directly" moreHref="/faq/" />
  </main>
  <Footer />
</Base>
