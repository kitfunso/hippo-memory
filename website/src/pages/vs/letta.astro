---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import VsTable from '../../components/VsTable.astro';
import { REPO } from '../../content/site';
import Faq from '../../components/Faq.astro';
import { faqPageLd } from '../../content/readme';

const title = 'hippo vs Letta: memory for the agents you already run';
const description =
  "hippo and Letta compared by the hippo team, features checked 28 September 2026. Letta Code is an agent with its memory built in; hippo adds a shared local store to Claude Code, Codex and Cursor.";
const rows = [
  ['Decay by default', 'Decay by default'],
  ['Retrieval strengthening', 'Recall strengthens a memory'],
  ['Outcome tracking', 'Outcome tracking'],
  ['Conflict detection + resolution', 'Conflict detection'],
  ['Multi-agent shared memory', 'Shared between agents'],
  ['Cross-tool import (ChatGPT/Claude/Cursor)', 'Import from other tools'],
  ['MCP server', 'MCP server'],
  ['Git-friendly', 'Git-friendly'],
  ['License', 'Licence'],
] as const;

const qa = [
  {
    q: "Is Letta the same as MemGPT?",
    a: 'Letta grew out of MemGPT, and its GitHub README calls it "Letta (f.k.a. MemGPT)". Active development has moved to Letta Code, and the original server now sits on an archive branch (checked 28 September 2026).',
  },
];
---

<Base title={title} description={description} crumb="hippo vs Letta" published="2026-09-28" schema={[faqPageLd(qa)]}>
  <Nav />
  <main id="main">
    <PageIntro>
      <Fragment slot="title">hippo vs <span class="text-gradient">Letta</span></Fragment>
      <p>
        Letta, formerly MemGPT, now builds Letta Code, an agent harness whose memory lives in blocks the agent edits itself. Hippo is memory for the agents you already run, such as Claude Code, Codex and Cursor, in one store they share. So the choice is mostly about whether you want to switch agents.
      </p>
    </PageIntro>

    <Section title="Who edits the memory">
      <p>
        Both keep memory where you can see it. Letta Code tracks its context in git, and hippo writes markdown mirrors you can commit. In Letta the agent rewrites its own memory blocks with built-in tools. In hippo, memories come from hooks, the CLI and MCP tools, and you can mark a recalled one wrong or replace an old fact.
      </p>
    </Section>

    <Section title="Published scores, loosely compared" alt>
      <p>
        On DMR, a public memory test of 495 questions, MemGPT published 93.4 and hippo scored 73.1 when we ran it. On LoCoMo, a test of questions about long conversations, the published Letta figure is 74.0 and hippo scored 89.4. Each number comes from a different setup and answer model, so neither settles much.
      </p>
    </Section>

    <Section title="Feature by feature">
      <p>
        The Letta column was checked against Letta's own pages on 28 September 2026. The full table is on
        <a class="link" href={`${REPO}#comparison`} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in new tab)</span></a>.
      </p>
      <VsTable system="Letta" rows={rows} />
    </Section>

    <Section title="What Letta ships today" alt>
      <p>
        Letta Code is Apache-2.0 and you connect your own model keys. Without signing in your agents are stored on local disk, and <code>/login</code> backs them up to Letta's cloud. The original Letta server, the MemGPT line, is retired to an archive branch (<a class="link" href="https://github.com/letta-ai/letta-code" target="_blank" rel="noopener noreferrer">Letta's pages<span class="sr-only"> (opens in new tab)</span></a>, checked 28 September 2026).
      </p>
    </Section>

    <Section title="When to pick which">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="glass rounded-2xl p-6">
          <h3 class="text-base font-medium text-zinc-100">Pick hippo</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick hippo when you already use Claude Code, Codex or Cursor and want them to share one store of lessons you can correct, on your machine with no account.
          </p>
        </div>
        <div class="glass rounded-2xl p-6">
          <h3 class="text-base font-medium text-zinc-100">Pick Letta</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick Letta when you want a coding agent whose memory is part of the agent, and you are ready to switch agents to get it.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 pt-4">
        <a href="/quickstart/" class="rounded-lg bg-zinc-100 inline-flex min-h-11 items-center px-5 text-sm font-medium text-zinc-900 transition hover:bg-white">Get started with hippo</a>
      </div>
    </Section>

    <Faq items={qa} heading="hippo and Letta, asked directly" moreHref="/faq/" />
  </main>
  <Footer />
</Base>
