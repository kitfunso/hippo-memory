---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import VsTable from '../../components/VsTable.astro';
import Faq from '../../components/Faq.astro';
import { faqPageLd } from '../../content/readme';

const title = 'hippo vs Letta: a Letta alternative for coding agents';
const description =
  'hippo vs Letta, checked 2026-09-28. Letta Code is a coding agent that edits its own memory blocks. hippo adds memory to Claude Code, Codex and Cursor.';

const qa = [
  {
    q: 'Is Letta the same as MemGPT?',
    a: 'Letta grew out of MemGPT; its GitHub README calls it "Letta (f.k.a. MemGPT)". Active development has moved to Letta Code, a coding agent, and the original Letta server now sits on an archive branch (checked 2026-09-28).',
  },
  {
    q: 'Is hippo a Letta alternative?',
    a: 'It depends on what you want from Letta. Letta Code is a coding agent with its memory built in. Hippo is memory for the agents you already use: Claude Code, Codex, Cursor and any MCP client share one store, on your machine with no account, and you can mark a lesson wrong or supersede an old fact. If you want an agent that manages its own memory blocks, that is Letta Code.',
  },
];
---

<Base title={title} description={description} crumb="hippo vs Letta" published="2026-09-28" schema={[faqPageLd(qa)]}>
  <Nav />
  <main id="main">
    <PageIntro eyebrow="Comparison">
      <Fragment slot="title">hippo vs Letta: a <span class="text-gradient">Letta alternative</span> for coding agents</Fragment>
      <p>
        Letta, formerly MemGPT, now builds Letta Code, a coding agent whose memory lives in blocks the agent edits itself.
        Hippo is not an agent. It is memory for the agents you already run, such as Claude Code, Codex and Cursor, in one
        store they share.
      </p>
      <p>
        Both keep memory where you can see it: Letta Code tracks its context in git, and hippo writes markdown mirrors you
        can commit. They differ in who edits memory. In Letta, the agent rewrites its own blocks with built-in tools. In
        hippo, memories come from hooks, the CLI and MCP tools, and you can mark a recalled one wrong or supersede an old
        fact.
      </p>
    </PageIntro>

    <Section title="Feature by feature" alt>
      <p>
        Every row of the README comparison table, hippo against Letta. The Letta column was last checked against Letta's
        own pages on 2026-09-28.
      </p>
      <VsTable system="Letta" />
    </Section>

    <Section title="What Letta ships today (checked 2026-09-28)">
      <ul class="list-disc space-y-2 pl-5">
        <li>
          Letta Code, Apache-2.0, installed with <code>npm install -g @letta-ai/letta-code</code>. You connect your own
          model API keys with <code>/connect</code>
          (<a class="link" href="https://github.com/letta-ai/letta-code" target="_blank" rel="noopener noreferrer">Letta Code<span class="sr-only"> (opens in new tab)</span></a>).
        </li>
        <li>
          Without signing in, "your agents are stored only on local disk"; <code>/login</code> backs them up to Letta's
          cloud
          (<a class="link" href="https://docs.letta.com/letta-agent/quickstart" target="_blank" rel="noopener noreferrer">quickstart<span class="sr-only"> (opens in new tab)</span></a>).
          All context, memory blocks included, is tracked in git.
        </li>
        <li>
          Memory blocks the agent reads and updates with built-in tools. Writing a block replaces its whole content, and
          when two processes write the same block at once, the last write wins
          (<a class="link" href="https://docs.letta.com/guides/core-concepts/memory/memory-blocks" target="_blank" rel="noopener noreferrer">memory blocks docs<span class="sr-only"> (opens in new tab)</span></a>).
        </li>
        <li>
          A hosted MCP server, used with a Letta API key, that lets an MCP agent create and message your Letta agents
          (<a class="link" href="https://docs.letta.com/platform/hosted-mcp" target="_blank" rel="noopener noreferrer">docs<span class="sr-only"> (opens in new tab)</span></a>).
        </li>
        <li>
          The original Letta server, the MemGPT line, is retired to an archive branch of
          <a class="link" href="https://github.com/letta-ai/letta" target="_blank" rel="noopener noreferrer">letta-ai/letta<span class="sr-only"> (opens in new tab)</span></a>.
          Letta Code has a free plan that uses your own API keys, and paid plans from $20 a month
          (<a class="link" href="https://docs.letta.com/letta-code/pricing" target="_blank" rel="noopener noreferrer">pricing<span class="sr-only"> (opens in new tab)</span></a>).
        </li>
      </ul>
    </Section>

    <Section title="When to pick which" alt>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="glass rounded-2xl p-6">
          <h3 class="text-base font-medium text-zinc-100">Pick hippo</h3>
          <p class="mt-2 text-sm leading-relaxed">
            You already use Claude Code, Codex or Cursor and want them to share one store of lessons that you can correct,
            on your machine with no account.
          </p>
        </div>
        <div class="glass rounded-2xl p-6">
          <h3 class="text-base font-medium text-zinc-100">Pick Letta</h3>
          <p class="mt-2 text-sm leading-relaxed">
            You want a coding agent whose memory is part of the agent, one that edits its own memory blocks, and you are
            ready to switch agents to get it.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 pt-4">
        <a href="/quickstart/" class="rounded-lg bg-zinc-100 px-5 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-white">Get started with hippo</a>
        <a href="/faq/" class="rounded-lg border border-white/12 px-5 py-2.5 text-sm font-medium text-zinc-200 transition hover:border-white/25">All questions</a>
      </div>
    </Section>

    <Faq items={qa} heading="hippo and Letta, asked directly" />
  </main>
  <Footer />
</Base>
