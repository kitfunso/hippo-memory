---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import VsTable from '../../components/VsTable.astro';
import data from '../../data/public-benchmarks.json';
import { REPO, site } from '../../content/site';
import Faq from '../../components/Faq.astro';
import { faqPageLd } from '../../content/readme';

const title = 'hippo vs mem0: a local, open-source alternative';
const description =
  "hippo and mem0 compared by the hippo team. On LoCoMo answers, both run here with one answer model, Mem0 leads hippo by 5.6 points; hippo stored the test with no model calls. Features checked 28 September 2026.";
const rows = [
  ['Decay by default', 'Decay by default'],
  ['Retrieval strengthening', 'Recall strengthens a memory'],
  ['Outcome tracking', 'Outcome tracking'],
  ['Conflict detection + resolution', 'Conflict detection'],
  ['Hybrid search (BM25 + embeddings)', 'Hybrid search'],
  ['Cross-tool import (ChatGPT/Claude/Cursor)', 'Import from other tools'],
  ['Auto-hook install', 'Installs its own hooks'],
  ['MCP server', 'MCP server'],
  ['Zero runtime deps', 'Zero runtime dependencies'],
  ['License', 'Licence'],
] as const;
// The LoCoMo result file the benchmarks data uses.
const locomoFile = `${site.links.repo}/blob/master/${data.benches.find((b) => b.name === 'LoCoMo')!.file}`;

const qa = [
  {
    q: "Is hippo an open-source mem0 alternative?",
    a: "Yes, if the memory is for coding agents on your own machine. Hippo is MIT-licensed, keeps memories in SQLite in your project and needs no account or API key. mem0 is Apache-2.0 and runs as a library, a self-hosted server or a hosted platform.",
  },
];
---

<Base title={title} description={description} crumb="hippo vs mem0" published="2026-06-09" schema={[faqPageLd(qa)]}>
  <Nav />
  <main id="main">
    <PageIntro>
      <Fragment slot="title">hippo vs <span class="text-ink">mem0</span></Fragment>
      <p>
        Both are open-source memory for AI agents, and they suit different jobs. mem0 uses a language model to extract memories, and memories stored through its hosted MCP server live in your Mem0 account. Hippo keeps memories in SQLite on your machine, needs no account and no model, and wires itself into the coding agents it finds.
      </p>
    </PageIntro>

    <Section title="One test we ran on both" id="two-published-numbers-two-different-metrics">
      <p>
        LoCoMo is a public test of questions about long, multi-session conversations. We ran both systems on it with the same answer model and scorer. Mem0 scored 94.9 and hippo 89.4. Paired question by question, hippo trails by 5.6 points [3.0, 8.1]. A second judge model gave 95.7 and 91.1. With less context the gap grows, to 7.1 points at the top 50 memories. Storing the conversations took Mem0 5,882 language-model calls and hippo none. Mem0 answers more of these questions, and hippo stores them without a model.
      </p>
      <p>
        <a class="link" href={locomoFile} target="_blank" rel="noopener noreferrer">The LoCoMo score file<span class="sr-only"> (opens in new tab)</span></a>
      </p>
    </Section>

    <Section title="Feature by feature" alt>
      <p>
        The Mem0 column was checked against mem0's own pages on 28 September 2026. The full table is on
        <a class="link" href={`${REPO}#comparison`} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in new tab)</span></a>.
      </p>
      <VsTable system="Mem0" rows={rows} />
    </Section>

    <Section title="What mem0 ships today">
      <p>
        mem0 runs three ways, as a library, as a self-hosted server on Postgres, and as the hosted Mem0 platform. The open-source library needs a key for a language-model provider, OpenAI by default. Its MCP server is hosted and needs a Mem0 account and API key. On the hosted platform a background process marks an older memory superseded when a newer fact replaces it (<a class="link" href="https://docs.mem0.ai/open-source/overview" target="_blank" rel="noopener noreferrer">mem0 docs<span class="sr-only"> (opens in new tab)</span></a>, checked 28 September 2026).
      </p>
    </Section>

    <Section title="When to pick which" alt>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-rule bg-paper-2 p-6">
          <h3 class="text-base font-medium text-ink">Pick hippo</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick hippo when the memory is for coding agents on your machine, and you want no account, no API key and no model in the loop, with lessons you can mark wrong and files you can commit.
          </p>
        </div>
        <div class="rounded-xl border border-rule bg-paper-2 p-6">
          <h3 class="text-base font-medium text-ink">Pick mem0</h3>
          <p class="mt-2 text-sm leading-relaxed">
            Pick mem0 when you are building an app whose memory belongs to your end users, the case mem0 describes as "customer support chatbots, AI assistants, and autonomous systems", or when its higher answer score matters more to you than running locally.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 pt-4">
        <a href="/quickstart/" class="btn">Get started with hippo</a>
      </div>
    </Section>

    <Faq items={qa} heading="hippo and mem0, asked directly" moreHref="/faq/" />
  </main>
  <Footer />
</Base>
