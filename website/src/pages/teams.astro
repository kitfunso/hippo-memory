---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';

// Enterprise v1 is in development (ROADMAP Part XII). Every feature below that is not
// shipped says so; the pilot measurement is the offer that exists today.
const agents = ['Claude Code', 'Copilot', 'Cursor', 'Codex'];
const sources = ['GitHub', 'GitLab', 'Jira', 'Slack'];
const pillars = [
  {
    title: 'Recall respects access',
    body: 'A memory learned in a private repository only reaches developers who can open that repository.',
    status: 'in development',
  },
  {
    title: 'Leads approve what spreads',
    body: 'A lesson moves from one repository to a team, or to the whole company, only after a tech lead approves it.',
    status: 'in development',
  },
  {
    title: 'Every write is on the record',
    body: 'An audit log of who stored, recalled, changed or forgot what. Keys scoped to tenants and roles.',
    status: 'shipped',
  },
];
const kpis = [
  { name: 'Cost per merged PR', how: 'from your agent’s own billing telemetry' },
  { name: 'Read tokens per session', how: 'the share spent re-reading files' },
  { name: 'Repeat-error rate', how: 'the same failure seen again in a later session' },
  { name: 'Guardrails', how: 'reverts, rejected reviews and CI failures must not rise' },
];
---

<Base
  title="hippo for teams: memory your platform team can approve"
  description="Enterprise hippo is in development: shared memory for every Claude Code and Copilot seat, run inside your network. Pilots measure it against a holdout."
  crumb="Teams"
>
  <Nav />
  <main id="main">
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 -z-10 hero-glow"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-24 pt-10 sm:pt-12 lg:grid-cols-2">
        <div class="min-w-0">
          <span class="inline-flex items-center gap-2 rounded-full border border-acc-amber/40 bg-acc-amber/10 px-3 py-1 font-mono text-xs text-acc-amber">
            Enterprise v1 · in development · pilots open
          </span>
          <h1 class="mt-6 font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl">
            The memory layer your <span class="text-gradient">platform team</span> can approve.
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-zinc-400">
            Enterprise hippo will be one plugin that turns on shared memory for every agent seat. It will run inside your network, recall only what each developer can already see, and log every write. No usage beacon, nothing sent home.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.links.pilot} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-xl bg-acc-violet px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:opacity-90">Ask about a 4-week pilot</a>
            <a href={site.links.security} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-xl border border-white/12 px-5 py-3 text-sm font-medium text-zinc-200 transition hover:bg-white/5">Security policy</a>
          </div>
        </div>

        <div class="glass min-w-0 rounded-2xl p-6" aria-label="How hippo deploys inside a company">
          <p class="font-mono text-xs uppercase tracking-wider text-zinc-400">How it deploys</p>
          <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {agents.map((a) => <li class="rounded-lg border border-white/10 px-3 py-2.5 text-center text-sm text-zinc-200">{a}</li>)}
          </ul>
          <p class="mt-3 text-center font-mono text-xs text-zinc-400">MCP over OAuth, signed in as the developer</p>
          <div class="mt-3 rounded-xl border-2 border-dashed border-acc-violet/50 p-4">
            <p class="font-mono text-xs text-acc-violet">YOUR NETWORK</p>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 rounded-lg bg-zinc-900 px-4 py-3">
              <span class="font-display text-base">hippo server</span>
              <span class="font-mono text-xs text-zinc-400">Postgres · Helm · SSO · audit log</span>
            </div>
            <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {sources.map((s) => <li class="rounded-md bg-white/[0.04] px-2 py-2 text-center text-sm text-zinc-300">{s}</li>)}
            </ul>
          </div>
          <p class="mt-4 text-sm text-zinc-400">Today: the MIT core, the HTTP server with tenants, API keys and an audit log, and GitHub and Slack connectors. Postgres, Helm, SSO and more sources are in development.</p>
        </div>
      </div>
    </section>

    <section class="border-t border-white/5">
      <div class="mx-auto grid max-w-6xl gap-4 px-5 py-24 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="glass flex flex-col gap-3 rounded-2xl p-6">
            <span class:list={['self-start rounded px-2 py-0.5 font-mono text-xs', p.status === 'shipped' ? 'bg-acc-violet/15 text-acc-violet' : 'bg-acc-amber/15 text-acc-amber']}>{p.status}</span>
            <h2 class="text-xl leading-snug">{p.title}</h2>
            <p class="text-sm leading-relaxed text-zinc-400">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 lg:grid-cols-2">
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-wider text-acc-violet">The pilot</p>
          <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">Measured on your work, against a holdout.</h2>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-zinc-400">
            For four weeks, a random share of sessions runs without memory. Both groups work on the same days, with the same people and models, so a model price change or a quiet week cannot fake a saving. The numbers come from your agent’s own telemetry, computed inside your network.
          </p>
          <p class="mt-4 max-w-lg text-sm text-zinc-400">If there is no difference, the report says so. We publish our own losses too.</p>
        </div>
        <ul class="glass min-w-0 divide-y divide-white/8 rounded-2xl">
          {kpis.map((k) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 px-6 py-4">
              <span class="font-display text-base">{k.name}</span>
              <span class="text-sm text-zinc-400">{k.how}</span>
            </li>
          ))}
          <li class="px-6 py-4 font-mono text-sm text-acc-violet">with hippo vs holdout · 95% interval · your result</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
