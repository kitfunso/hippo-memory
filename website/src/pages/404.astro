---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
---

<Base
  title={`Page not found - ${site.name}`}
>
  <main
    id="main"
    class="mx-auto flex min-h-screen max-w-xl flex-col items-center justify-center gap-6 px-6 text-center"
  >
    <h1 class="font-display text-[2.5rem] leading-(--leading-display) sm:text-[3.5rem]">
      This memory decayed.
    </h1>
    <p class="max-w-md leading-relaxed text-ink-2">Nothing lives at this address.</p>
    <a
      href="/"
      class="btn"
    >
      Back to home
    </a>
  </main>
</Base>
