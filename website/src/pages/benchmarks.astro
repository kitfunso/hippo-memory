---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';

const title = 'hippo benchmarks: retrieval on LongMemEval and LoCoMo';
// Each clause states its corpus and its bound BEFORE its numbers: this string is the
// meta, OG, Twitter and JSON-LD description, and those travel without the page that
// qualifies them. Any truncation that reaches the numbers has already shown the bound.
const description =
  "hippo's retrieval on the public LongMemEval benchmark, with the code and data to reproduce it. hippo recall on a default install, inside its 4,000-token budget: 85.6% R@5, and 96.8% with the budget lifted. Best of five settings in the benchmark scripts: 98.0%. Separately, on a private 300-query developer store, the opt-in Jev reranker improves ranking only: no answer-rate win was shown. R@1 0.41 to 0.62.";

// Verified against docs/evals/2026-09-28-recall-cli-longmemeval-result.md, Results table.
const recallRuns = [
  { run: 'Default install, 4,000-token budget', r5: '85.6', ci: '[82.4, 88.6]' },
  { run: 'With the optional MiniLM embedder, 4,000-token budget', r5: '87.6', ci: '[84.6, 90.4]' },
  { run: 'Default install, budget lifted', r5: '96.8', ci: '[95.2, 98.2]' },
  { run: 'With MiniLM, budget lifted', r5: '97.4', ci: '[96.0, 98.6]' },
];
const auditUrl = `${site.links.repo}/blob/master/docs/evals/2026-09-23-mechanism-audit-round2-result.md`;

// Verified against README.md, docs/evals/2026-09-23-longmemeval-reproduction.md (MiniLM) and 2026-06-09-longmemeval-per-haystack-dual.md (voyage, global pool).
const perHaystack = [
  { embedder: 'MiniLM-L6 (local, optional install)', r1: '88.4', r5: '98.0', r10: '99.4' },
  { embedder: 'voyage-3-large (opt-in, June 2026)', r1: '94.6', r5: '99.8', r10: '99.8' },
];
const globalPool = [
  { embedder: 'MiniLM-L6 (local, optional install)', r5: '47.2' },
  { embedder: 'voyage-3-large (opt-in)', r5: '56.4' },
];

// Verified against benchmarks/LOCOMO_INVESTIGATION.md "Per-category" table (v1.25.0 run, 2026-07-05, 3 dp).
const locomo = [
  { category: 'single-hop', n: '282', r5: '0.239' },
  { category: 'multi-hop', n: '321', r5: '0.491' },
  { category: 'temporal-reasoning', n: '92', r5: '0.169' },
  { category: 'open-domain', n: '841', r5: '0.450' },
  { category: 'adversarial', n: '446', r5: '0.226' },
  { category: 'overall', n: '1,982', r5: '0.363' },
];
const locomoDocUrl = `${site.links.repo}/blob/master/benchmarks/LOCOMO_INVESTIGATION.md`;

// Verified against docs/evals/2026-09-19-jev-reranker.md, ranking table, 300-query
// developer store, n=300, 40 candidates each. Intervals are 98.75%.
const rerank = [
  { metric: 'R@1', base: '0.260', ce: '0.413', jev: '0.617', delta: '+0.203 [0.133, 0.273]' },
  { metric: 'R@5', base: '0.460', ce: '0.613', jev: '0.740', delta: '+0.127 [0.080, 0.177]' },
  { metric: 'MRR', base: '0.358', ce: '0.509', jev: '0.672', delta: '+0.163 [0.113, 0.217]' },
  { metric: 'recall at the token budget', base: '0.693', ce: '0.740', jev: '0.747', delta: '+0.007 [0.000, 0.020], tied' },
];

const benchUrl = `${site.links.longmemeval}`;
const evalIndexUrl = `${site.links.repo}/blob/master/docs/evals/README.md`;
const reproUrl = `${site.links.repo}/blob/master/docs/evals/2026-09-23-longmemeval-reproduction.md`;

// Hero chip group: reuses the page's own receipts (no new claims).
const heroChips = [
  { num: '85.6%', label: 'R@5, hippo recall, 4,000-token budget' },
  { num: '0.62', label: 'R@1, --reranker jev (dev store)' },
  { num: site.tests, label: 'tests, real database' },
  { num: '0', label: 'outbound HTTP' },
];

---

<Base title={title} description={description} crumb="Benchmarks" published="2026-06-09" modified="2026-09-28">
  <Nav />
  <main id="main">
    <!-- Header -->
    <section class="relative scroll-mt-20">
      <div class="mx-auto flex max-w-6xl items-end justify-between gap-10 px-5 pb-12 pt-28 sm:pt-32">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Benchmarks</p>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-semibold leading-[1.03] tracking-tight sm:text-5xl">
            Numbers, with the <span class="text-gradient">methodology</span>.
          </h1>
          <p class="mt-5 max-w-2xl leading-relaxed text-zinc-400">
            hippo's retrieval, measured on <a class="link" href="https://arxiv.org/abs/2410.10813" target="_blank" rel="noopener noreferrer">LongMemEval<span class="sr-only"> (opens in new tab)</span></a> (ICLR 2025), the public 500-question memory benchmark, and on <a class="link" href="https://arxiv.org/abs/2402.17753" target="_blank" rel="noopener noreferrer">LoCoMo<span class="sr-only"> (opens in new tab)</span></a>, 10 long multi-session conversations. The harness, the data hash, and the per-question results for both are in the repo so you can rerun them.
          </p>
        </div>
        <!-- Metric chips fill the hero's right side on wide viewports; duplicates on-page data. -->
        <div class="hidden w-60 shrink-0 flex-col gap-3 lg:flex" aria-hidden="true">
          {heroChips.map((chip) => (
            <div class="glass flex items-baseline justify-between gap-3 rounded-2xl px-4 py-3">
              <span class="whitespace-nowrap font-mono text-xl font-semibold tracking-tight text-gradient">{chip.num}</span>
              <span class="text-right text-xs leading-snug text-zinc-400">{chip.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Standard per-haystack -->
    <section class="relative scroll-mt-20 border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">Standard task: per-question&nbsp;haystack</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          Each question ships its own haystack of about 48 conversation sessions, and the job is to retrieve the session that holds the answer. This is the standard LongMemEval-S setup, the same one published systems report. Recall at 5, on the <code class="rounded bg-white/[0.04] px-1.5 py-0.5 font-mono text-sm text-zinc-300">_s</code> split, counting a hit when any answer session is in the top 5, over all 500 questions.
        </p>
        <h3 class="mt-10 text-lg font-medium text-zinc-100">hippo recall, as installed</h3>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-white/8">
          <table class="w-full min-w-[30rem] text-left text-sm">
            <thead class="bg-white/[0.03] font-mono text-xs uppercase tracking-wider text-zinc-400">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Run</th>
                <th scope="col" class="px-5 py-3 font-medium">R@5</th>
                <th scope="col" class="px-5 py-3 font-medium">95% CI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {recallRuns.map((row) => (
                <tr class="text-zinc-300">
                  <th scope="row" class="px-5 py-3.5 text-left font-normal">{row.run}</th>
                  <td class="px-5 py-3.5 font-mono font-semibold text-gradient">{row.r5}</td>
                  <td class="px-5 py-3.5 font-mono text-xs text-zinc-400">{row.ci}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          Each memory in this test is a whole session, about 2,600 tokens at the median, so the default budget returns a median of 2 sessions. That budget is most of the gap to the scripts below. A lifted call returns every candidate, a median of 47 sessions and 123,491 tokens per question, so the lifted rows measure the ranking, not an amount of text an agent could take in. Method and limits: <a class="link" href={site.links.recallEval} target="_blank" rel="noopener noreferrer">the hippo recall eval<span class="sr-only"> (opens in new tab)</span></a>.
        </p>
        <h3 class="mt-12 text-lg font-medium text-zinc-100">The benchmark scripts, best of five settings</h3>
        <div class="mt-4 overflow-hidden rounded-2xl border border-white/8">
          <table class="w-full text-left text-sm">
            <thead class="bg-white/[0.03] font-mono text-xs uppercase tracking-wider text-zinc-400">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Embedder</th>
                <th scope="col" class="px-5 py-3 font-medium">R@1</th>
                <th scope="col" class="px-5 py-3 font-medium">R@5</th>
                <th scope="col" class="px-5 py-3 font-medium">R@10</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {perHaystack.map((row) => (
                <tr class="text-zinc-300">
                  <th scope="row" class="px-5 py-3.5 text-left font-normal">{row.embedder}</th>
                  <td class="px-5 py-3.5 font-mono">{row.r1}</td>
                  <td class="px-5 py-3.5 font-mono font-semibold text-gradient">{row.r5}</td>
                  <td class="px-5 py-3.5 font-mono">{row.r10}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          The scripts in benchmarks/longmemeval index every turn and fuse BM25 with dense ranks; they are not hippo recall. With a free local embedder they reach 98.0% at the best of five settings. The June 2026 build scored 98.6%, and the <a class="link" href={reproUrl} target="_blank" rel="noopener noreferrer">re-measure<span class="sr-only"> (opens in new tab)</span></a> shows both runs.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-400">
          The stricter measure counts a hit only when every answer session is in the top 5, over the 470 questions that have an answer. The same runs score 86.8 to 88.5% there. gbrain first published 97.6%, an any-session score, and its <a class="link" href="https://github.com/garrytan/gbrain-evals/blob/main/docs/benchmarks/2026-05-07-longmemeval-s.md" target="_blank" rel="noopener noreferrer">report<span class="sr-only"> (opens in new tab)</span></a> now leads with the strict one: 95.53% (449 of 470) with the paid Voyage rerank-2.5 reranker, 93.19% without it. On strict recall gbrain is ahead. Any-session recall is near its ceiling on this task; strict recall is not.
        </p>
      </div>
    </section>

    <!-- Large-store / global pool -->
    <section class="relative scroll-mt-20 border-t border-white/5">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">Large store: one unified memory</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          Point retrieval at a single store of all 19,195 sessions, with no pre-scoped haystack, closer to how an agent's memory actually accumulates. Recall stops being free (measured June 2026):
        </p>
        <div class="mt-8 grid grid-cols-2 gap-4">
          {globalPool.map((row) => (
            <div class="glass rounded-2xl p-6">
              <span class="font-mono text-4xl font-semibold tracking-tight text-zinc-200">{row.r5}</span>
              <span class="mt-3 block text-sm text-zinc-400">R@5 &middot; {row.embedder}</span>
            </div>
          ))}
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          A stronger embedder helps here (47 to 56) but neither is usable on its own: the answer drowns among thousands of distractors. This is where we expect the memory lifecycle to matter, and measuring it is the next benchmark on the roadmap.
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-400">
          It is not shown yet. Decay and sleep are design choices, and the tests so far do not favour them. In the <a class="link" href={auditUrl} target="_blank" rel="noopener noreferrer">mechanism audit<span class="sr-only"> (opens in new tab)</span></a>, decay had no measurable effect against decay switched off: -0.7 points [-1.4, 0.1], on a 20-session synthetic test too short for a 365-day half-life to act. Sleep lowered LongMemEval hit@5 by 3.6 points [-5.8, -1.4] under the audit's declared scorer, and no scorer there showed sleep helping recall. Nothing published shows hippo making agents better at their work.
        </p>
      </div>
    </section>

    <!-- Reranking: the Jev result, win and null together -->
    <section id="reranking" class="relative scroll-mt-20 border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">Reranking: what a paid model bought, and what it&nbsp;did&nbsp;not</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          <code class="rounded bg-white/[0.04] px-1.5 py-0.5 font-mono text-sm text-zinc-300">hippo recall "&lt;query&gt;" --reranker jev</code> sends the top 40 candidates to the hosted <a class="link" href="https://typesafe.ai" target="_blank" rel="noopener noreferrer">TypeSafe Jev<span class="sr-only"> (opens in new tab)</span></a> API and reorders them. It is off by default and the default recall path makes no network call. Ranking on a private 300-query developer store, so unlike the two benchmarks above this one is not redistributable and you cannot rerun it. All figures aggregated over 2,000-draw paired bootstrap runs, with 98.75% intervals:
        </p>
        <div class="mt-8 overflow-x-auto rounded-2xl border border-white/8">
          <table class="w-full min-w-[34rem] text-left text-sm">
            <thead class="bg-white/[0.03] font-mono text-xs uppercase tracking-wider text-zinc-400">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Metric</th>
                <th scope="col" class="px-5 py-3 font-medium">Base</th>
                <th scope="col" class="px-5 py-3 font-medium">Cross-encoder</th>
                <th scope="col" class="px-5 py-3 font-medium">Jev</th>
                <th scope="col" class="px-5 py-3 font-medium">Jev minus cross-encoder</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {rerank.map((row) => (
                <tr class="text-zinc-300">
                  <th scope="row" class="px-5 py-3.5 text-left font-normal">{row.metric}</th>
                  <td class="px-5 py-3.5 font-mono">{row.base}</td>
                  <td class="px-5 py-3.5 font-mono">{row.ce}</td>
                  <td class="px-5 py-3.5 font-mono font-semibold text-gradient">{row.jev}</td>
                  <td class="px-5 py-3.5 font-mono text-xs text-zinc-400">{row.delta}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          The R@1 margin held in 20 of 20 bootstrap seeds, and a permutation null with arm labels shuffled inside each query reached it in 0 of 200 runs. The R@1 margin replicated on LongMemEval at n=500, +0.0700 [0.0200, 0.1200]; R@5 tied there. Cost is about 0.0004 USD a recall, p50 295&nbsp;ms over 300 calls.
        </p>
        <div class="mt-8 max-w-2xl rounded-2xl border border-amber-400/20 bg-amber-400/[0.04] p-6">
          <p class="font-mono text-xs uppercase tracking-wider text-amber-300/90">What it did not do</p>
          <p class="mt-3 text-sm leading-relaxed text-zinc-300">
            Better ranking did not produce better answers. Three graded-answer tests on LongMemEval all tied against the free local cross-encoder, and those three share one 150-question set, so they are not three independent tries. What Jev buys today is a shorter context: 2 Jev-ranked memories answer as well as 5 ranked by the cross-encoder, roughly 900 fewer tokens a query. Turning it on also sends your query and candidate memory text to a third party.
          </p>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          Method, every interval, the cost table and the full limits list: <a class="link" href={site.links.jevEval} target="_blank" rel="noopener noreferrer">the Jev reranker eval<span class="sr-only"> (opens in new tab)</span></a>.
        </p>
      </div>
    </section>

    <!-- Other receipts -->
    <section class="relative scroll-mt-20 border-t border-white/5">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">Tested, and local by default</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="glass rounded-2xl p-6">
            <span class="font-mono text-4xl font-semibold tracking-tight text-gradient">74%</span>
            <span class="mt-3 block text-sm font-medium text-zinc-200">R@5, BM25 only</span>
            <span class="mt-2 block text-xs leading-relaxed text-zinc-400">Zero dependencies, no embeddings required at runtime.</span>
          </div>
          <div class="glass rounded-2xl p-6">
            <span class="font-mono text-4xl font-semibold tracking-tight text-gradient">{site.tests}</span>
            <span class="mt-3 block text-sm font-medium text-zinc-200">tests, real database</span>
            <span class="mt-2 block text-xs leading-relaxed text-zinc-400">No module mocks and no mocked store. Only paid network calls are stubbed.</span>
          </div>
          <div class="glass rounded-2xl p-6">
            <span class="font-mono text-4xl font-semibold tracking-tight text-gradient">0</span>
            <span class="mt-3 block text-sm font-medium text-zinc-200">outbound HTTP</span>
            <span class="mt-2 block text-xs leading-relaxed text-zinc-400">Local SQLite, proven by a fetch spy on the ingestion smoke.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Methodology + reproduce -->
    <section class="relative scroll-mt-20 border-t border-white/5 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">Reproduce it</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          The data is <code class="rounded bg-white/[0.04] px-1.5 py-0.5 font-mono text-sm text-zinc-300">longmemeval_s_cleaned.json</code> (SHA-256 <code class="font-mono text-xs text-zinc-400">d6f21ea9...</code>), 500 questions over 19,195 sessions. Retrieval is turn-level dense plus BM25, fused with reciprocal rank fusion and max-pooled to session, by the scripts in benchmarks/longmemeval rather than hippo recall. Embeddings are L2-normalized; the local embedder is MiniLM (an optional install), with an opt-in pluggable provider for frontier embedders. The hippo recall runs use the same data, scorer and k, with one memory per session.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          Every measurement hippo has published, pre-registrations kept next to their results, is indexed in <a class="link" href={evalIndexUrl} target="_blank" rel="noopener noreferrer">docs/evals<span class="sr-only"> (opens in new tab)</span></a>. That index includes the runs that failed and the one claim we retracted.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={benchUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-zinc-100 px-5 py-2.5 text-sm font-medium text-zinc-900 transition hover:bg-white">Benchmark harness &amp; data<span class="sr-only"> (opens in new tab)</span></a>
          <a href={evalIndexUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/12 px-5 py-2.5 text-sm font-medium text-zinc-200 transition hover:border-white/25">All eval documents<span class="sr-only"> (opens in new tab)</span></a>
          <a href={site.links.repo} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-white/12 px-5 py-2.5 text-sm font-medium text-zinc-200 transition hover:border-white/25">Repository<span class="sr-only"> (opens in new tab)</span></a>
        </div>
      </div>
    </section>
    <!-- LoCoMo per-category disclosure -->
    <section class="relative scroll-mt-20 border-t border-white/5">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <h2 class="text-balance text-3xl leading-tight sm:text-4xl">LoCoMo: conversational evidence&nbsp;recall</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-zinc-400">
          <a class="link" href="https://arxiv.org/abs/2402.17753" target="_blank" rel="noopener noreferrer">LoCoMo<span class="sr-only"> (opens in new tab)</span></a> is 10 long multi-session conversations, 5,882 turns and 1,986 questions. hippo scores it deterministically: did the gold evidence turn land in the top 5 recalled memories? No LLM judge. Measured once on v1.25.0 (2026-07-05) with MiniLM-L6, the default embedder then and an optional install since 1.28.0:
        </p>
        <div class="mt-8 overflow-hidden rounded-2xl border border-white/8">
          <table class="w-full text-left text-sm">
            <thead class="bg-white/[0.03] font-mono text-xs uppercase tracking-wider text-zinc-400">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Category</th>
                <th scope="col" class="px-5 py-3 font-medium">n</th>
                <th scope="col" class="px-5 py-3 font-medium">Evidence R@5</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {locomo.map((row) => (
                <tr class="text-zinc-300">
                  <th scope="row" class="px-5 py-3.5 text-left font-normal">{row.category}</th>
                  <td class="px-5 py-3.5 font-mono">{row.n}</td>
                  <td class="px-5 py-3.5 font-mono font-semibold text-gradient">{row.r5}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-zinc-400">
          A point estimate, not an exact value: n=1, and the run predates the v1.26.0 determinism fix and a harness fix that lost tags on 0.9% of stored rows. Not comparable to the LLM-as-judge numbers Mem0 and Letta publish. Informational only, gates no feature. Protocol, caveats and regeneration commands: <a class="link" href={locomoDocUrl} target="_blank" rel="noopener noreferrer">LOCOMO_INVESTIGATION.md<span class="sr-only"> (opens in new tab)</span></a>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
