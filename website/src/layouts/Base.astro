---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Head from '../components/Head.astro';
import Beacon from '../components/Beacon.astro';

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head {...props} />
    <!-- preload only the faces the first screen paints; 600 loads on use -->
    <Font cssVariable="--font-newsreader" preload={[{ weight: '400' }]} />
    <Font cssVariable="--font-geist" preload={[{ weight: '400' }, { weight: '500' }]} />
    <Font cssVariable="--font-geist-mono" preload={[{ weight: '400' }]} />
    <meta name="theme-color" content="#f7f4ee" />
    <meta name="color-scheme" content="light" />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-paper"
    >
      Skip to content
    </a>
    <slot />
    <div id="copy-live" class="sr-only" aria-live="polite"></div>
    <!-- Lives in the layout because the components that carry data-copy appear on many pages. -->
    <script is:inline>
      (function () {
        // copy-to-clipboard
        var live = document.getElementById('copy-live');
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-copy');
            if (!text || !navigator.clipboard) return;
            navigator.clipboard.writeText(text).then(function () {
              var label = btn.querySelector('[data-copy-label]');
              if (live) live.textContent = 'Copied to clipboard';
              if (label) {
                var prev = label.textContent;
                label.textContent = 'Copied';
                setTimeout(function () { label.textContent = prev; }, 1600);
              }
            }).catch(function () {});
          });
        });

        // [data-scroll-x]: flag "more to the right" so global.css fades that edge only while it is true.
        // A region that scrolls and holds nothing focusable joins the tab order, so keyboard users can scroll it.
        document.querySelectorAll('[data-scroll-x]').forEach(function (el) {
          var caption = el.querySelector('caption');
          var needsStop = !el.querySelector('a[href], button, input, select, textarea, [tabindex]');
          var update = function () {
            var scrolls = el.scrollWidth > el.clientWidth + 1;
            el.toggleAttribute('data-more', el.scrollLeft + el.clientWidth < el.scrollWidth - 4);
            if (!needsStop) return;
            if (scrolls) {
              el.tabIndex = 0;
              if (caption) { el.setAttribute('role', 'region'); el.setAttribute('aria-label', caption.textContent.trim()); }
            } else {
              el.removeAttribute('tabindex');
              el.removeAttribute('role');
              el.removeAttribute('aria-label');
            }
          };
          el.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        });
      })();
    </script>
    <Beacon />
  </body>
</html>
