  const shift = (v) => [v[0] * DATA.ex[0] + v[1] * DATA.ey[0] + v[2] * DATA.ez[0], v[0] * DATA.ex[1] + v[1] * DATA.ey[1] + v[2] * DATA.ez[1]];
