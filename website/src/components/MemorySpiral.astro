---
// The brand mark, live: a hippocampus curl drawn with memories (three.js).
// Mint nodes are recalled lessons, dim ones are fading, the amber one was marked
// wrong. A recall pulse travels the curve. Static frame under reduced motion; a
// flat SVG mark shows if WebGL is unavailable.
import dots from '../content/logo-mark.json';
---

<section id="how-it-remembers" class="relative scroll-mt-20 border-t border-white/5">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-24 lg:grid-cols-2">
    <div class="relative mx-auto aspect-square w-full max-w-[520px]">
      <canvas data-spiral class="h-full w-full" aria-label="Animated hippo mark: a spiral of memories, with a recall pulse travelling along it" role="img"></canvas>
      <svg data-spiral-fallback viewBox="0 0 64 64" class="absolute inset-0 m-auto hidden h-2/3 w-2/3" aria-hidden="true">
        {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.fill} fill-opacity={d.opacity} />)}
      </svg>
    </div>

    <div class="min-w-0">
      <p class="font-mono text-xs uppercase tracking-wider text-acc-violet">How hippo remembers</p>
      <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">Every lesson is a point of light. Use keeps it lit.</h2>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-zinc-400">
        The mark is a hippocampus, the part of the brain that decides what to keep. Hippo applies the same rules to what your agents learn.
      </p>
      <ul class="mt-8 flex max-w-lg flex-col gap-5">
        <li class="flex gap-4">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-acc-violet shadow-[0_0_14px_rgba(124,227,139,0.7)]"></span>
          <span><span class="font-medium text-zinc-100">Recalled.</span> <span class="text-zinc-400">A memory that gets used grows stronger and lasts longer.</span></span>
        </li>
        <li class="flex gap-4">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-zinc-100/35"></span>
          <span><span class="font-medium text-zinc-100">Fading.</span> <span class="text-zinc-400">Unused memories fade over a year, a default we have not tuned, then move to a dormant store you can restore.</span></span>
        </li>
        <li class="flex gap-4">
          <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-acc-amber"></span>
          <span><span class="font-medium text-zinc-100">Marked wrong.</span> <span class="text-zinc-400">A lesson that turned out wrong drops out of recall. Ban a value and it never returns.</span></span>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import type { Mesh, Sprite, MeshBasicMaterial, SpriteMaterial, WebGLRenderer } from 'three';

  const MINT = 0x7ce38b, AMBER = 0xf2b84b, BONE = 0xe6ede7;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-spiral]');
  const fallback = document.querySelector<SVGElement>('[data-spiral-fallback]');

  async function start(el: HTMLCanvasElement) {
    // three.js loads only when this section nears the viewport.
    const {
      WebGLRenderer, Scene, PerspectiveCamera, Group, Mesh, SphereGeometry, MeshBasicMaterial,
      Sprite, SpriteMaterial, CanvasTexture, AdditiveBlending, Line, LineBasicMaterial,
      BufferGeometry, CatmullRomCurve3, Vector3,
    } = await import('three');
    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas: el, antialias: true, alpha: true });
    } catch {
      el.style.display = 'none';
      fallback?.classList.remove('hidden');
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    const scene = new Scene();
    const camera = new PerspectiveCamera(35, 1, 0.1, 100);
    camera.position.set(0, 0, 7);

    const tex = (() => {
      const c = document.createElement('canvas');
      c.width = c.height = 64;
      const g = c.getContext('2d')!;
      const grd = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grd.addColorStop(0, 'rgba(255,255,255,1)');
      grd.addColorStop(0.3, 'rgba(255,255,255,0.35)');
      grd.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grd;
      g.fillRect(0, 0, 64, 64);
      return new CanvasTexture(c);
    })();

    let seed = 7;
    const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
    const group = new Group();
    scene.add(group);
    type Node = { mesh: Mesh; mat: MeshBasicMaterial; haloMat: SpriteMaterial | null; t: number; base: number; wrong: boolean };
    const nodes: Node[] = [];
    const N = 110;
    for (let i = 0; i < N; i++) {
      const t = i / (N - 1);
      const ang = 0.5 + t * Math.PI * 3.3;
      const r = 1.55 * (1 - t * 0.78);
      const pos = new Vector3(Math.cos(ang) * r, Math.sin(ang) * r * 1.08, (t - 0.5) * 1.3 + Math.sin(t * 9) * 0.08);
      const strong = rnd() > 0.78;
      const wrong = i === 38;
      const base = wrong || strong ? 1 : 0.22 + rnd() * 0.25;
      const mat = new MeshBasicMaterial({ color: wrong ? AMBER : strong ? MINT : BONE, transparent: true, opacity: base });
      const mesh = new Mesh(new SphereGeometry(wrong ? 0.08 : strong ? 0.075 + rnd() * 0.04 : 0.035 + rnd() * 0.02, 16, 12), mat);
      mesh.position.copy(pos);
      group.add(mesh);
      let haloMat: SpriteMaterial | null = null;
      if (strong || wrong) {
        haloMat = new SpriteMaterial({ map: tex, color: wrong ? AMBER : MINT, transparent: true, opacity: 0.5, blending: AdditiveBlending, depthWrite: false });
        const halo: Sprite = new Sprite(haloMat);
        halo.scale.set(0.55, 0.55, 1);
        halo.position.copy(pos);
        group.add(halo);
      }
      nodes.push({ mesh, mat, haloMat, t, base, wrong });
    }
    const curve = new CatmullRomCurve3(nodes.map((n) => n.mesh.position.clone()));
    group.add(new Line(new BufferGeometry().setFromPoints(curve.getPoints(400)), new LineBasicMaterial({ color: MINT, transparent: true, opacity: 0.12 })));
    group.rotation.x = -0.25;

    const resize = () => {
      const w = el.clientWidth, h = el.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener('resize', resize);

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const t0 = performance.now();
    let visible = true;
    new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); }).observe(el);

    const frame = (now: number) => {
      const time = reduce ? 2.4 : (now - t0) / 1000;
      if (visible || reduce) {
        group.rotation.y = Math.sin(time * 0.35) * 0.55;
        const phase = (time * 0.18) % 1.2;
        for (const n of nodes) {
          if (n.wrong) continue;
          const boost = Math.max(0, 1 - Math.abs(n.t - phase) * 14);
          n.mat.opacity = Math.min(1, n.base + boost * 0.8);
          if (n.haloMat) n.haloMat.opacity = 0.45 + boost * 0.5;
        }
        renderer.render(scene, camera);
      }
      if (!reduce) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  if (canvas) {
    // Start only when the section is near the viewport, so three.js never blocks first paint.
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); void start(canvas); }
    }, { rootMargin: '200px' });
    io.observe(canvas);
  }
</script>
