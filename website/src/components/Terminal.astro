---
import { terminal } from '../content/site';

type Kind = (typeof terminal)[number]['kind'];
// Mint is hippo recalling or saving, amber is the failure it caught (the brand's "marked wrong").
const tone: Record<Kind, string> = {
  note: 'text-zinc-500',
  cmd: 'text-term-fg',
  out: 'text-zinc-300',
  err: 'pl-4 text-term-err',
  caught: 'pl-4 text-acc-amber',
  ok: 'pl-4 text-term-ok',
  mem: 'pl-8 text-zinc-300',
};
const glyph: Partial<Record<Kind, string>> = { cmd: '>', out: '●', err: '⎿', mem: '·' };
---

<div class="overflow-hidden rounded-xl border border-zinc-800 bg-term-bg" data-terminal>
  <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-3">
    <span class="size-3 rounded-full bg-zinc-700" aria-hidden="true"></span>
    <span class="size-3 rounded-full bg-zinc-700" aria-hidden="true"></span>
    <span class="size-3 rounded-full bg-zinc-700" aria-hidden="true"></span>
    <span class="ml-3 font-mono text-xs text-zinc-500">claude · with hippo hooks</span>
  </div>

  <div class="overflow-x-auto px-6 py-5 font-mono text-[13px] leading-6" data-term-body>
    {terminal.map((line) => (
      <div
        class:list={[
          'term-line flex items-start gap-2',
          tone[line.kind],
          line.kind === 'note' && 'mt-4 border-t border-dashed border-zinc-800 pt-4 first:mt-0 first:border-0 first:pt-0',
        ]}
        data-kind={line.kind}
      >
        {glyph[line.kind] && (
          <span class:list={['select-none', line.kind === 'cmd' && 'text-zinc-400']}>{glyph[line.kind]}</span>
        )}
        <span class="term-text min-w-0 flex-1 break-words">{line.text}</span>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    var body = document.querySelector('[data-term-body]');
    if (!body) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) return; // accessible final state already rendered

    var lines = Array.prototype.slice.call(body.querySelectorAll('.term-line'));
    var data = lines.map(function (l) {
      var t = l.querySelector('.term-text');
      return { line: l, el: t, full: t ? t.textContent : '', kind: l.getAttribute('data-kind') };
    });
    lines.forEach(function (l) { l.style.opacity = '0'; });

    var started = false;
    function run() {
      if (started) return;
      started = true;
      var i = 0;
      function next() {
        if (i >= data.length) return;
        var d = data[i];
        d.line.style.opacity = '1';
        if (d.kind === 'cmd' && d.el) {
          d.el.textContent = '';
          var c = 0;
          (function type() {
            d.el.textContent = d.full.slice(0, c);
            if (c < d.full.length) { c++; setTimeout(type, 16); }
            else { i++; setTimeout(next, 240); }
          })();
        } else {
          i++;
          setTimeout(next, 220);
        }
      }
      next();
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { run(); io.disconnect(); }
      });
    }, { threshold: 0.4 });
    io.observe(body);
  })();
</script>
