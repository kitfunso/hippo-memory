---
import { problem } from '../content/site';
---

<section class="relative border-t border-white/5 bg-white/[0.02]">
  <div class="mx-auto max-w-6xl px-5 py-(--section-y)">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-acc-cyan">{problem.kicker}</p>
        <h2 class="mt-4 max-w-xl text-3xl leading-tight sm:text-4xl">
          {problem.heading}
        </h2>
        <div class="mt-6 max-w-lg space-y-4 text-lg leading-relaxed text-zinc-400">
          {problem.body.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <!-- A repeated failure is stored once, as the capture-error hook does; the motif shows the mechanism, not a later run succeeding. -->
      <div class="flex min-w-0 items-center" data-reveal>
        <div class="w-full min-w-0 space-y-3 font-mono text-sm" aria-hidden="true">
          {[1, 2, 3].map((n) => (
            <div class="flex items-center gap-3 rounded-lg border border-white/5 bg-white/[0.015] px-4 py-3 text-zinc-400">
              <span class="text-rose-400/60">✗</span>
              <span class="min-w-0 flex-1">deploy failed: forgot migrations</span>
              <span class="shrink-0 text-zinc-400">run #{n}</span>
            </div>
          ))}
          <div class="ring-grad flex items-center gap-3 rounded-lg bg-white/[0.03] px-4 py-3 text-zinc-200">
            <span class="text-emerald-400">+</span>
            <span class="min-w-0 flex-1">stored once as an error memory</span>
            <span class="shrink-0 rounded bg-emerald-500/15 px-1.5 py-0.5 text-xs text-emerald-300">[observed]</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
