---
// The pain, as scenes a developer recognises; heading left, a ruled list right from lg up.
import { problem } from '../content/site';
import { mdInline } from '../content/readme';
import Band from './Band.astro';
---

<Band id="problem">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2>{problem.heading}</h2>
      <p class="mt-5 text-body leading-relaxed text-ink-2">{problem.intro}</p>
    </div>
    <ol class="border-t border-rule">
      {problem.items.map((item) => (
        <li class="border-b border-rule py-6">
          <h3 class="text-[1.0625rem] text-ink">{item.title}</h3>
          <p class="copy mt-2 leading-relaxed text-ink-2" set:html={mdInline(item.text)} />
        </li>
      ))}
    </ol>
  </div>
</Band>
