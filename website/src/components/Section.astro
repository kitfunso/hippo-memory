---
import { slug } from '../lib/slug';
// The default id drops a "(checked 2026-09-28)" suffix so a date never lands in an anchor.
// `split` puts the heading in a left column from lg up, as on the home page.
interface Props {
  title: string;
  id?: string;
  alt?: boolean;
  split?: boolean;
}
const { title, id = slug(title.replace(/\s*\([^)]*\)/g, '')), alt = false, split = false } = Astro.props;
---

<section id={id} class:list={['relative border-t border-rule', alt && 'bg-paper-2']}>
  <div
    class:list={[
      'wrap py-(--section-y)',
      split && 'lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16',
    ]}
  >
    <h2
      class:list={[
        'max-w-3xl',
        split && 'lg:sticky lg:top-24 lg:self-start',
      ]}
    >{title}</h2>
    <div
      class:list={[
        'copy max-w-3xl space-y-4 leading-relaxed text-ink-2',
        split ? 'mt-6 text-body lg:mt-1' : 'mt-6',
      ]}
    >
      <slot />
    </div>
  </div>
</section>
