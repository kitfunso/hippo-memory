---
import { slug } from '../lib/slug';
// One titled block of long-form copy; `alt` shades every other section, as on the home page.
// The default id drops a "(checked 2026-09-28)" suffix so a date never lands in an anchor.
interface Props {
  title: string;
  id?: string;
  alt?: boolean;
}
const { title, id = slug(title.replace(/\s*\([^)]*\)/g, '')), alt = false } = Astro.props;
---

<section id={id} class:list={['relative border-t border-white/5', alt && 'bg-white/[0.02]']}>
  <div class="mx-auto max-w-6xl px-5 py-(--section-y)">
    <h2 class="max-w-3xl text-balance text-3xl leading-tight sm:text-4xl">{title}</h2>
    <div class="copy mt-6 max-w-3xl space-y-4 leading-relaxed text-zinc-400">
      <slot />
    </div>
  </div>
</section>
