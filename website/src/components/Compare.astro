---
import { compare, comparison } from '../content/site';

// Color-code cells for scannability. All tones pass AA contrast on the dark table.
function cellTone(v: string): string {
  if (v === 'Yes' || v.startsWith('Yes')) return 'text-emerald-400';
  if (v === 'No' || v.startsWith('No')) return 'text-zinc-400';
  if (v.startsWith('Partial')) return 'text-amber-300';
  if (v === '?' || v.startsWith('N/A')) return 'text-zinc-400';
  return 'text-zinc-300';
}

// Home shows 6 rows x every system of the README table; the GitHub link carries readers to all rows.
// A cell shows its short verdict, the README cell minus its parenthetical, keeping footnote marks.
const shortVerdict = (cell: string) => cell.replace(/\s*\(([^)]*)\)/g, (_, inner: string) => inner.match(/\*+/)?.[0] ?? '');
const homeFeatures = [
  'Decay by default',
  'Retrieval strengthening',
  'Cross-tool import (ChatGPT/Claude/Cursor)',
  'Auto-hook install',
  'Zero runtime deps',
  'LongMemEval (best published)',
];
const systems = comparison.systems;
// A README rename must fail the build here, not drop a row from the page.
const rows = homeFeatures.map((f) => {
  const row = comparison.rows.find((r) => r.feature === f);
  if (!row) throw new Error(`README comparison has no "${f}" row`);
  return { feature: row.feature, cells: row.cells.map(shortVerdict) };
});
---

<section id="compare" class="relative border-t border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-(--section-y)">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Compare</p>
      <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">
        <span class="text-gradient">{compare.heading}</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400" data-reveal>{compare.body}</p>
    </div>

    <!-- trimmed matrix; horizontal scroll is CONTAINED to this wrapper (never the page) -->
    <div class="relative mt-10">
      <!-- Equal fixed columns; the table fits without scrolling from lg up, so the feature column only sticks below it. -->
      <div class="overflow-x-auto rounded-2xl glass" data-scroll-x>
        <table class="w-full min-w-[60rem] table-fixed border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10">
              <th
                scope="col"
                class="sticky left-0 z-20 w-36 border-r border-white/10 bg-zinc-900 px-4 py-3 font-mono text-xs uppercase tracking-wider text-zinc-400 sm:w-52 lg:static lg:bg-transparent"
              >
                Feature
              </th>
              {systems.map((s) => (
                <th scope="col" class:list={['px-2 py-3 text-center align-bottom font-sans text-[13px] font-semibold leading-tight', s.self ? 'bg-acc-violet/5' : '']}>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      'underline-offset-4 transition hover:underline',
                      s.self ? 'text-gradient' : 'text-zinc-300 hover:text-zinc-100',
                    ]}
                  >{s.name}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class:list={['border-b border-white/5 last:border-b-0', i % 2 === 1 ? 'bg-white/[0.015]' : '']}>
                <th
                  scope="row"
                  class="sticky left-0 z-10 border-r border-white/10 bg-zinc-900 px-4 py-3 text-left font-normal text-zinc-200 [overflow-wrap:anywhere] lg:static lg:bg-transparent"
                >
                  {row.feature}
                </th>
                {row.cells.map((c, ci) => (
                  <td
                    class:list={[
                      'px-2 py-3 text-center align-middle text-[13px] leading-snug',
                      cellTone(c),
                      ci === 0 ? 'bg-acc-violet/5 font-medium' : '',
                    ]}
                  >{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 font-mono text-xs text-zinc-400 lg:hidden">{compare.scrollCue} →</p>

    <div class="mt-5 max-w-3xl space-y-1.5 text-sm leading-relaxed text-zinc-400" data-reveal>
      {compare.notes.map((n) => <p>{n}</p>)}
      <p class="pt-3 text-zinc-300">{comparison.closing}</p>
      <p class="pt-1">
        <a href={compare.sourceHref} target="_blank" rel="noopener noreferrer" class="link">{compare.sourceLabel} →</a>
      </p>
    </div>
  </div>
</section>
