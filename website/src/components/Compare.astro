---
import { compare, comparison } from '../content/site';
import { mdInline } from '../content/readme';

// Color-code cells for scannability. All tones pass AA contrast on the dark table.
function cellTone(v: string): string {
  if (v === 'Yes' || v.startsWith('Yes')) return 'text-emerald-400';
  if (v === 'No' || v.startsWith('No')) return 'text-zinc-400';
  if (v.startsWith('Partial')) return 'text-amber-300';
  if (v === '?' || v.startsWith('N/A')) return 'text-zinc-400';
  return 'text-zinc-300';
}

// Home shows 6 fact rows x 4 systems of the README's first table, including rows where others are stronger;
// the design bets stay on GitHub. A cell shows its short verdict, the README cell minus its parenthetical, keeping footnote marks.
const shortVerdict = (cell: string) => cell.replace(/\s*\(([^)]*)\)/g, (_, inner: string) => inner.match(/\*+/)?.[0] ?? '');
const homeSystems = ['Hippo', 'Mem0', 'gbrain', 'Zep'];
const homeFeatures = [
  'Where your data lives',
  'Needs an account or model key',
  'License',
  'Managed multi-user service',
  'Graph or entity relations',
  'LongMemEval (published)',
];
// A README rename must fail the build here, not drop a column or row from the page.
const sysIdx = homeSystems.map((n) => {
  const i = comparison.systems.findIndex((s) => s.name === n);
  if (i < 0) throw new Error(`README comparison has no "${n}" column`);
  return i;
});
const systems = sysIdx.map((i) => comparison.systems[i]);
const rows = homeFeatures.map((f) => {
  const row = comparison.rows.find((r) => r.feature === f);
  if (!row) throw new Error(`README comparison has no "${f}" row`);
  return { feature: row.feature, cells: sysIdx.map((i) => shortVerdict(row.cells[i])) };
});
---

<section id="compare" class="relative border-t border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-(--section-y)">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Compare</p>
      <h2 class="mt-4 text-3xl leading-tight sm:text-4xl">
        <span class="text-gradient">{compare.heading}</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400" data-reveal>{compare.body}</p>
    </div>

    <!-- trimmed matrix; horizontal scroll is CONTAINED to this wrapper (never the page) -->
    <div class="relative mt-10">
      <!-- Equal fixed columns: auto layout let the long LongMemEval cells set every column's width. -->
      <div class="overflow-x-auto rounded-2xl glass" data-scroll-x>
        <table class="w-full min-w-[640px] table-fixed border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10">
              <th
                scope="col"
                class="sticky left-0 z-20 w-40 border-r border-white/10 bg-zinc-900 px-4 py-3 font-mono text-xs uppercase tracking-wider text-zinc-400"
              >
                Feature
              </th>
              {systems.map((s) => (
                <th scope="col" class="px-2 py-3 text-center align-bottom font-sans text-[13px] font-semibold">
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      'underline-offset-4 transition hover:underline',
                      s.self ? 'text-gradient' : 'text-zinc-300 hover:text-zinc-100',
                    ]}
                  >{s.name}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class:list={['border-b border-white/5', i % 2 === 1 ? 'bg-white/[0.015]' : '']}>
                <th
                  scope="row"
                  class="sticky left-0 z-10 w-40 border-r border-white/10 bg-zinc-900 px-4 py-3 text-left font-normal text-zinc-200"
                >
                  {row.feature}
                </th>
                {row.cells.map((c, ci) => (
                  <td
                    class:list={[
                      'min-w-[8.5rem] px-3 py-2.5 text-center align-top text-[13px] leading-snug',
                      cellTone(c),
                      ci === 0 ? 'bg-acc-violet/5 font-medium' : '',
                    ]}
                  >{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 font-mono text-xs text-zinc-400 sm:hidden">{compare.scrollCue} →</p>

    <p class="mt-5 text-sm">
      <a href={compare.sourceHref} target="_blank" rel="noopener noreferrer" class="link">
        {compare.sourceLabel} →
      </a>
    </p>

    <div class="mt-4 gap-x-12 *:mb-2 lg:columns-2" data-reveal>
      {comparison.footnotes.map((f) => <p class="copy break-inside-avoid text-sm leading-relaxed text-zinc-400" set:html={mdInline(f)} />)}
      <p class="break-inside-avoid text-sm leading-relaxed text-zinc-400">{compare.qualifierNote}</p>
      <p class="break-inside-avoid pt-4 text-sm leading-relaxed text-zinc-400">{comparison.closing}</p>
    </div>
  </div>
</section>
