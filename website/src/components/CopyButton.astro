---
// The click handler is the one in layouts/Base.astro, which reads data-copy and flips the data-copy-label text.
interface Props {
  text: string;
  label: string;
}
const { text, label } = Astro.props;
---

<button
  type="button"
  data-copy={text}
  aria-label={label}
  class="relative shrink-0 rounded-md border border-rule-strong bg-paper-2 px-2.5 py-1 font-sans text-xs font-medium text-ink-2 transition-colors duration-150 after:absolute after:-inset-2 after:content-[''] hover:border-ink hover:text-ink focus-visible:text-ink active:scale-[0.97]"
>
  <span data-copy-label>Copy</span>
</button>
