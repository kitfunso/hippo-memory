---
// Shared head tags: title, canonical, share card and JSON-LD. Base and the home page both use it.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../content/site';
import { pageDate } from '../lib/page-dates.mjs';

interface Props {
  title?: string;
  description?: string;
  /** This page's own JSON-LD nodes (TechArticle, HowTo, FAQPage), merged into the site-wide @graph. */
  schema?: object[];
  /** Breadcrumb name for a sub-page, read as Home > crumb. */
  crumb?: string;
  /** Set on article pages: adds a TechArticle node; dateModified comes from git. */
  published?: string;
}

const {
  title = `${site.pkg}: ${site.positioning}`,
  description = site.description,
  schema = [],
  crumb,
  published,
} = Astro.props;
const article = published
  ? [{ '@type': 'TechArticle', headline: title, description, datePublished: published, dateModified: pageDate(Astro.url.pathname) }]
  : [];

// All URLs derive from astro.config `site` -> a later domain swap is one edit.
const base = Astro.site ?? new URL('https://hippo-memory.com');
const home = base.href;
const canonical = new URL(Astro.url.pathname, base).href;

// scripts/make-images.mjs draws one card per built page; a page built before its card exists borrows home's.
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const ogPath = existsSync(join(process.cwd(), 'public', 'og', `${slug}.png`)) ? `/og/${slug}.png` : '/og/home.png';
const ogImage = new URL(ogPath, base).href;

const id = { org: `${home}#org`, website: `${home}#website`, software: `${home}#software` };
const graph = [
  {
    '@type': 'Organization',
    '@id': id.org,
    name: 'kitfunso',
    url: 'https://github.com/kitfunso',
    logo: new URL('/apple-touch-icon.png', base).href,
    sameAs: ['https://github.com/kitfunso'],
  },
  {
    '@type': 'WebSite',
    '@id': id.website,
    url: home,
    name: site.pkg,
    alternateName: [site.name],
    description: site.description,
    publisher: { '@id': id.org },
    sameAs: [site.links.repo, site.links.npm],
  },
  {
    '@type': 'SoftwareApplication',
    '@id': id.software,
    name: site.pkg,
    alternateName: site.name,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Node.js 22.16+',
    description: site.description,
    url: home,
    softwareVersion: site.version,
    license: 'https://opensource.org/licenses/MIT',
    author: { '@id': id.org },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    sameAs: [site.links.repo, site.links.npm],
    downloadUrl: site.links.npm,
    keywords:
      'AI agent memory, persistent memory for Claude Code, Cursor memory, Codex memory, MCP memory server, long-term memory for LLM agents, local-first, open source',
  },
  ...(crumb
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: home },
          { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
        ],
      }]
    : []),
  ...[...article, ...schema].map((node) => ({
    url: canonical,
    isPartOf: { '@id': id.website },
    about: { '@id': id.software },
    author: { '@id': id.org },
    publisher: { '@id': id.org },
    ...node,
  })),
];
---

<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={site.pkg} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
