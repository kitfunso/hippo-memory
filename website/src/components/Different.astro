---
// Why hippo is not another layer of model calls: the claim left, four facts in a 2 by 2 grid right.
import { different } from '../content/site';
import { mdInline } from '../content/readme';
import Band from './Band.astro';
---

<Band id="different" tone="paper-2">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div>
      <h2>{different.heading}</h2>
      <p class="copy mt-5 text-body leading-relaxed text-ink-2" set:html={mdInline(different.intro)} />
    </div>
    <ul class="grid gap-x-10 border-t border-rule sm:grid-cols-2">
      {different.items.map((item) => (
        <li class="border-b border-rule py-6">
          <h3 class="text-[1.0625rem] text-ink">{item.title}</h3>
          <p class="copy mt-2 leading-relaxed text-ink-2" set:html={mdInline(item.text)} />
        </li>
      ))}
    </ul>
  </div>
</Band>
