---
import { site, nav } from '../content/site';
import { getStats } from '../lib/stats';

const stats = await getStats(); // build-time; cached + fallback (see lib/stats.ts)

// "/benchmarks/" -> "/benchmarks", "/" -> "/"
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const isHome = currentPath === '/';
// Hash and external links never mark a page; styling hook lives in global.css.
const isCurrent = (href: string) =>
  href.startsWith('/') && !href.includes('#') && normalizePath(href) === currentPath;
// /teams leads with its own filled button (the pilot), so install steps back to an outline there.
const quietInstall = currentPath === '/teams';

// Phone row: on home the section jumps; elsewhere the same labels as the desktop nav, so there is one set.
const sectionChips = [
  { label: 'A session', href: '/#session' },
  { label: 'The test', href: '/#receipts' },
  { label: 'Public tests', href: '/#public-tests' },
  { label: 'How it works', href: '/#how' },
  { label: 'Install', href: '/#get-started' },
];
const mobileNav = isHome ? sectionChips : nav;
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/95 backdrop-blur-sm">
  <nav aria-label="Primary" class="wrap flex h-16 items-center gap-10 text-sm">
    <a href="/" aria-label="hippo, home" class="inline-flex min-h-11 items-center font-display text-[1.375rem] leading-none text-ink">hippo</a>

    <ul class="hidden flex-1 items-center gap-7 text-ink-2 md:flex">
      {nav.map((item) => (
        <li>
          <a
            class="transition-colors duration-150 hover:text-ink"
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-1">
      <a
        href={site.links.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Star hippo on GitHub, ${stats.starsLabel} stars`}
        class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-ink-2 transition-colors duration-150 hover:text-ink"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span class="font-mono text-[13px] tabular-nums">{stats.starsLabel}</span>
      </a>
      <a
        href="/quickstart/"
        class:list={[
          'inline-flex h-9 items-center rounded-lg px-4 font-medium transition-colors duration-150',
          quietInstall
            ? 'border border-rule-strong text-ink hover:bg-paper-3'
            : 'bg-ink text-paper hover:bg-accent-deep',
        ]}
      >Install</a>
    </div>
  </nav>
</header>

<!-- phone nav, < md only: outside the sticky header so it scrolls away and the bar stays one row -->
<nav aria-label={isHome ? 'Page sections' : 'Pages'} class="border-b border-rule md:hidden">
  <ul class="flex gap-2 overflow-x-auto px-5 py-2 text-[13px] text-ink-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-scroll-x>
    {mobileNav.map((item) => (
      <li class="shrink-0">
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class="inline-flex min-h-11 items-center rounded-lg border border-rule bg-paper-2 px-3.5 transition-colors duration-150 hover:text-ink"
        >{item.label}</a>
      </li>
    ))}
  </ul>
</nav>
