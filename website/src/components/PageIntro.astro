---
// Header for the content pages: the h1 (named slot "title") and a lead paragraph or two.
---

<section class="relative">
  <div class="mx-auto max-w-6xl px-5 pb-12 pt-10 sm:pt-12">
    <h1 class="max-w-3xl text-balance font-display text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl">
      <slot name="title" />
    </h1>
    <div class="copy mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-zinc-400">
      <slot />
    </div>
  </div>
</section>
