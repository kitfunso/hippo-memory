---
// The Z0 round 3 card: one claim and the three rates behind it, shared by the home, benchmarks and comparison pages.
import { repeatMistakes as z } from '../content/site';
---

<a
  href={z.href}
  target="_blank"
  rel="noopener noreferrer"
  class="glass glass-hover group grid gap-8 rounded-2xl p-6 sm:p-8 lg:grid-cols-2 lg:items-center"
>
  <div class="flex flex-col">
    <span class="font-mono text-[clamp(2rem,9vw,3.5rem)] font-medium leading-none tracking-tight text-gradient">{z.stat}</span>
    <span class="mt-4 text-lg font-medium leading-snug text-zinc-100">{z.label}</span>
    <span class="mt-3 text-sm leading-relaxed text-zinc-400">{z.note}</span>
    <span class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-zinc-400 transition group-hover:text-acc-cyan">
      source ↗<span class="sr-only"> (the Z0 round 3 result, opens in new tab)</span>
    </span>
  </div>

  <dl class="space-y-5">
    {z.bars.map((b) => (
      <div>
        <div class="flex items-baseline justify-between gap-3">
          <dt class:list={['text-sm', b.lead ? 'font-medium text-zinc-100' : 'text-zinc-400']}>{b.name}</dt>
          <dd class:list={['font-mono text-sm tabular-nums', b.lead ? 'text-acc-cyan' : 'text-zinc-300']}>{b.rate} {z.unit}</dd>
        </div>
        <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-white/5" aria-hidden="true">
          <div class:list={['h-full rounded-full', b.lead ? 'bg-acc-cyan' : 'bg-zinc-600']} style={`width: ${b.rate}%`}></div>
        </div>
      </div>
    ))}
  </dl>
</a>
