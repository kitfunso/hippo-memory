---
// The three Z0 round 3 rates only; each page that shows them writes its own words around them.
import { repeatMistakes as z } from '../content/site';
---

<ul class="space-y-5">
  {z.bars.map((b) => (
    <li>
      <span class="flex items-baseline justify-between gap-3">
        <span class:list={['text-sm', b.lead ? 'font-medium text-zinc-100' : 'text-zinc-400']}>{b.name}</span>
        <span class:list={['font-mono text-sm tabular-nums', b.lead ? 'text-accent-light' : 'text-zinc-300']}>{b.rate} {z.unit}</span>
      </span>
      <span class="mt-2 block h-2.5 overflow-hidden rounded-full bg-white/5" aria-hidden="true">
        <span class:list={['block h-full rounded-full', b.lead ? 'bg-accent-light' : 'bg-zinc-600']} style={`width: ${b.rate}%`}></span>
      </span>
    </li>
  ))}
</ul>
