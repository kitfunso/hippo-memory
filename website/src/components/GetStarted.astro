---
import { site, getStarted } from '../content/site';
import { mdInline } from '../content/readme';
import Section from './Section.astro';
import CopyCommand from './CopyCommand.astro';
import CopyButton from './CopyButton.astro';
---

<Section title={getStarted.heading} id="get-started" split alt>
  <p set:html={mdInline(getStarted.body)} />
  <div class="space-y-3">
    {getStarted.steps.map((cmd) => <CopyCommand command={cmd} />)}
  </div>
  <p class="text-sm">{getStarted.notice}</p>
  <p>{getStarted.askLabel}</p>
  <div class="flex items-start gap-3 rounded-xl border border-rule-strong bg-paper p-4 font-mono text-sm leading-6">
    <p class="min-w-0 flex-1 break-words text-ink">{getStarted.prompt}</p>
    <CopyButton text={getStarted.prompt} label="Copy the prompt for your agent" />
  </div>
  <p class="flex flex-wrap gap-x-6 gap-y-2">
    <a class="link" href={site.links.repo} target="_blank" rel="noopener noreferrer"
      >View the source<span class="sr-only"> (opens in new tab)</span></a
    >
    <a class="link" href={site.links.npm} target="_blank" rel="noopener noreferrer"
      >View on npm<span class="sr-only"> (opens in new tab)</span></a
    >
  </p>
</Section>
