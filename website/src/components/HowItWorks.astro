---
import { mechanics } from '../content/site';
import { mdInline } from '../content/readme';
import DecayCurve from './DecayCurve.tsx';

interface Props {
  // The /how-it-works/ page already shows this eyebrow in its PageIntro.
  eyebrow?: boolean;
}
const { eyebrow = true } = Astro.props;
---

<section id="how" class="relative scroll-mt-20 border-t border-white/5">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <div class="max-w-2xl">
      {eyebrow && <p class="mb-4 font-mono text-xs uppercase tracking-wider text-acc-cyan">How it works</p>}
      <h2 class="text-3xl leading-tight sm:text-4xl">
        Memories decay. Retrieval makes them <span class="text-gradient">stronger.</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">
        The layers borrow from the brain as design inspiration. On our tests, decay made no measurable difference to recall and sleep cost a little. Outcome marks and retrieval strengthening are what measured helpful; supersession is not measured yet.
      </p>
    </div>

    <!-- the three stores: buffer -> episodic -> semantic -->
    <div class="mt-10 grid items-stretch gap-3 sm:grid-cols-[1fr_auto_1fr_auto_1fr]" data-reveal>
      <div class="glass flex flex-col rounded-2xl p-5">
        <span class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Buffer</span>
        <p class="mt-2 text-sm leading-relaxed text-zinc-400">New information lands here. Session-only, no decay.</p>
      </div>
      <div class="flex items-center justify-center font-mono text-xs text-zinc-400" aria-hidden="true">encode</div>
      <div class="glass flex flex-col rounded-2xl p-5">
        <span class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Episodic</span>
        <p class="mt-2 text-sm leading-relaxed text-zinc-400">Timestamped, decays by default. Retrieval strengthens it; errors stick.</p>
      </div>
      <div class="flex items-center justify-center font-mono text-xs text-zinc-400" aria-hidden="true">sleep</div>
      <div class="glass flex flex-col rounded-2xl p-5">
        <span class="font-mono text-xs uppercase tracking-wider text-acc-cyan">Semantic</span>
        <p class="mt-2 text-sm leading-relaxed text-zinc-400">Related episodes merge into one memory. The originals decay.</p>
      </div>
    </div>
    <p class="mt-3 text-center font-mono text-xs text-zinc-400">weak traces are forgotten; repeated ones consolidate during sleep</p>

    <!-- curve centerpiece -->
    <div class="mt-10 rounded-2xl glass p-6 sm:p-8">
      <DecayCurve client:visible />
      <p class="mt-4 text-center font-mono text-xs text-zinc-400">
        one memory, three futures, computed from hippo's default strength formula
      </p>
    </div>

    <!-- the four mechanics, bound to the curve above by the shared accent -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {mechanics.map((m) => (
        <div class="glass glass-hover flex flex-col rounded-2xl p-6">
          <span class="font-mono text-sm text-gradient">{m.metric}</span>
          <h3 class="mt-3 text-lg font-semibold">{m.title}</h3>
          <p class="copy mt-2 text-sm leading-relaxed text-zinc-400" set:html={mdInline(m.body)} />
        </div>
      ))}
    </div>
  </div>
</section>
