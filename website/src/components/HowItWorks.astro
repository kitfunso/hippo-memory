---
// The three stores and the decay curve for /how-it-works/; the page's sections give each mechanism and its result.
import DecayCurve from './DecayCurve.tsx';

const layers = [
  { name: 'Buffer', body: 'New information lands here for the session.' },
  { name: 'Episodic', body: 'Timestamped memories that fade unless they are used.' },
  { name: 'Semantic', body: 'Patterns merged from related episodes during sleep.' },
] as const;
---

<section id="layers" class="relative border-t border-rule">
  <div class="wrap py-(--section-y)">
    <ol class="grid border-y border-rule sm:grid-cols-3">
      {layers.map((l, i) => (
        <li class:list={['flex flex-col py-5 sm:px-5', i > 0 && 'border-t border-rule sm:border-t-0 sm:border-l', i === 0 && 'sm:pl-0']}>
          <p class="text-[1.0625rem] font-medium text-ink">{l.name}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-2">{l.body}</p>
        </li>
      ))}
    </ol>

    <div class="mt-10 rounded-xl border border-rule p-6 sm:p-8">
      <DecayCurve client:visible />
    </div>
  </div>
</section>
