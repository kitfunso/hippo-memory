---
// Public-benchmark answer scores: receipt tiles, then one field-strip card per benchmark, ranked by hippo's place.
// Data: website/src/data/public-benchmarks.json, written by benchmarks/public/site_data.py from the score files.
import data from '../data/public-benchmarks.json';
import { site } from '../content/site';
import { type Bench, f1, fmt, ordinal, podium, shortName, strip } from '../lib/bench-strip';

const benches = (data.benches as Bench[]).slice().sort((a, b) => {
  const score = (x: Bench) => (x.rank === null || x.field === null ? 2 : (podium(x) ? 0 : 1) + x.rank / x.field);
  return score(a) - score(b);
});
const blob = (file: string) => `${site.links.repo}/blob/master/${file}`;
const signed = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '') + f1(Math.abs(v));
const verdict = (r: { lo: number; hi: number }) => (r.lo > 0 ? 'win' : r.hi < 0 ? 'loss' : 'tie');
const rivalsOf = (b: Bench) => b.rivals.filter((r) => !r.name.startsWith('hippo')).sort((p, q) => q.diff - p.diff);

const lead = benches.filter(podium).slice(0, 2);
const leadTiles = (lead.length ? lead : benches.slice(0, 1)).map((b) => ({
  stat: fmt(b, b.hippo),
  label: `${shortName(b)}, ${ordinal(b.rank!)} of ${b.field} memory systems`,
}));
const wins = benches.flatMap((b) => rivalsOf(b).filter((r) => r.lo > 0).map((r) => ({ b, r })));
const bestWin = wins.sort((p, q) => q.r.diff - p.r.diff)[0];
const store = data.storeCalls;
const tiles = [
  ...leadTiles,
  { stat: String(store.hippo), label: `LLM calls for hippo to store ${store.bench}. Mem0 made ${store.mem0.toLocaleString('en-GB')}.` },
  ...(bestWin ? [{ stat: signed(bestWin.r.diff), label: `points over ${bestWin.r.name} on ${shortName(bestWin.b)}, same answer model and scorer` }] : []),
];
const tileCols = tiles.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';

// One drawing per breakpoint, so 12px labels stay 12px: phone, sm, md (one column), lg (two columns).
const SIZES = [
  { w: 272, cls: 'block max-w-[22rem] sm:hidden' },
  { w: 536, cls: 'hidden sm:block md:hidden' },
  { w: 664, cls: 'hidden md:block lg:hidden' },
  { w: 410, cls: 'hidden lg:block' },
];
const rows = (b: Bench) => [
  { name: 'hippo', value: b.hippo, setup: 'run here', me: true },
  ...b.rivals.map((r) => ({ name: r.name, value: r.value, setup: 'run here', me: false })),
  ...b.published.map((p) => ({ name: p.name, value: p.value, setup: p.kind === 'paper-baseline' || p.name === 'Full chat' ? 'published, baseline' : 'published', me: false })),
].sort((p, q) => q.value - p.value);
---

<div class:list={['grid gap-4 sm:grid-cols-2', tileCols]}>
  {tiles.map((t) => (
    <div class="glass flex flex-col rounded-2xl p-5">
      <span class="font-mono text-3xl font-medium tracking-tight text-gradient">{t.stat}</span>
      <span class="mt-2 text-sm leading-snug text-zinc-300">{t.label}</span>
    </div>
  ))}
</div>

<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-zinc-400">
  <li class="flex items-center gap-2"><span class="inline-block size-3.5 rounded-full border-2 border-zinc-950 bg-accent" aria-hidden="true"></span>hippo</li>
  <li class="flex items-center gap-2"><span class="inline-block size-2.5 rounded-full bg-zinc-400" aria-hidden="true"></span>run here, same answer model and scorer</li>
  <li class="flex items-center gap-2"><span class="inline-block size-2.5 rounded-full border-[1.5px] border-zinc-400" aria-hidden="true"></span>published, each team's own setup</li>
</ul>

<div class="mt-5 grid gap-6 lg:grid-cols-2">
  {benches.map((b) => (
    <article class="glass flex flex-col rounded-2xl p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h3 class="text-xl font-medium text-zinc-100">{shortName(b)}</h3>
        {podium(b) && (
          <span class="rounded-full bg-accent/15 px-2.5 py-0.5 font-mono text-xs text-accent-light">{ordinal(b.rank!)} of {b.field}</span>
        )}
        <a class="tap ml-auto font-mono text-xs text-zinc-400 hover:text-accent-light" href={blob(b.file)} target="_blank" rel="noopener noreferrer">source ↗<span class="sr-only"> (the {shortName(b)} score file, opens in new tab)</span></a>
      </div>
      <span class="mt-4 font-mono text-[clamp(2rem,8vw,3rem)] font-medium leading-none tracking-tight text-gradient">{fmt(b, b.hippo)}</span>
      <span class="mt-2 text-sm text-zinc-400">hippo answer {b.unit === 'F1' ? 'F1' : 'accuracy'}, {b.n} questions</span>
      <ul class="mt-4 flex flex-wrap gap-2">
        {rivalsOf(b).map((r) => (
          <li
            class:list={[
              'rounded-full px-2.5 py-1 font-mono text-xs',
              { 'bg-accent/10 text-accent-light': verdict(r) === 'win', 'bg-warn/10 text-warn': verdict(r) === 'loss', 'bg-white/5 text-zinc-300': verdict(r) === 'tie' },
            ]}
            title={`hippo minus ${r.name}, paired by question: ${signed(r.diff)} points, 95% interval ${signed(r.lo)} to ${signed(r.hi)}`}
          >
            {verdict(r) === 'win' ? `ahead of ${r.name} ${signed(r.diff)}` : verdict(r) === 'loss' ? `behind ${r.name} ${signed(r.diff)}` : `level with ${r.name}`}
          </li>
        ))}
      </ul>
      <div class="mt-6">
        {SIZES.map(({ w, cls }) => {
          const s = strip(b, w);
          return (
            <svg viewBox={`0 0 ${s.w} ${s.h}`} class:list={['h-auto w-full font-mono text-xs', cls]} role="img" aria-label={`${shortName(b)}: published scores and scores run here, also in the table below`}>
              {s.ticks.map((t) => <line x1={t.x} x2={t.x} y1={s.gridTop} y2={s.gridBottom} class="stroke-zinc-800" />)}
              {s.ticks.map((t) => <text x={t.x} y={s.h - 4} text-anchor={t.anchor} class="fill-zinc-400">{t.v}</text>)}
              <line x1="0" x2={s.w} y1={s.divY} y2={s.divY} class="stroke-zinc-700" />
              <text x="0" y="12" class="fill-zinc-400">{b.published.length ? 'Published' : 'Published: none'}</text>
              <text x="0" y={s.divY + 16} class="fill-zinc-400">Run here</text>
              {s.dots.map((d) => (
                <circle
                  cx={d.x}
                  cy={d.y}
                  r={d.r}
                  stroke-width={d.tone === 'pub' ? 1.5 : 2}
                  class:list={{ 'fill-zinc-950 stroke-zinc-400': d.tone === 'pub', 'fill-zinc-400 stroke-zinc-950': d.tone === 'here', 'fill-accent stroke-zinc-950': d.tone === 'hippo' }}
                >
                  <title>{d.title}</title>
                </circle>
              ))}
              {s.labels.map((l) => <text x={l.x} y={l.y} text-anchor={l.anchor} class={l.strong ? 'fill-zinc-100' : 'fill-zinc-300'}>{l.text}</text>)}
            </svg>
          );
        })}
      </div>
      <details class="mt-4">
        <summary class="inline-flex min-h-11 cursor-pointer items-center font-mono text-xs text-zinc-400 hover:text-accent-light">All scores</summary>
        <div class="mt-2 overflow-x-auto rounded-xl border border-white/8" data-scroll-x>
          <table class="w-full text-left text-sm">
            <thead class="bg-white/[0.03] font-mono text-xs uppercase tracking-wider text-zinc-400">
              <tr><th scope="col" class="px-4 py-2.5 font-medium">System</th><th scope="col" class="px-4 py-2.5 font-medium">Setup</th><th scope="col" class="px-4 py-2.5 text-right font-medium">Score</th></tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {rows(b).map((r) => (
                <tr class={r.me ? 'text-zinc-100' : 'text-zinc-300'}>
                  <th scope="row" class:list={['px-4 py-2.5 text-left', r.me ? 'font-medium' : 'font-normal']}>{r.name}</th>
                  <td class="px-4 py-2.5 text-zinc-400">{r.setup}</td>
                  <td class:list={['px-4 py-2.5 text-right font-mono tabular-nums', { 'text-accent-light': r.me }]}>{fmt(b, r.value)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </article>
  ))}
</div>
