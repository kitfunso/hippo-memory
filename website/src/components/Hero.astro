---
// Words left and the figure right from lg up; the agents and the proof strip run under both. The figure comes in through the slot.
import { site, proofs, getStarted, worksWith } from '../content/site';
import CopyCommand from './CopyCommand.astro';

const external = (href: string) => href.startsWith('http');
---

<section class="relative">
  <div class="wrap pb-16 pt-12 sm:pt-16 lg:pb-20 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-12">
      <div class="rise flex min-w-0 flex-col">
        <h1 class="text-balance font-display text-[2.75rem] leading-(--leading-display) sm:text-[3.25rem] lg:text-[3.5rem]">
          {site.tagline.lead} {site.tagline.accent}
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-2">{site.tagline.summary}</p>
        <div class="mt-8 max-w-[28rem]">
          <CopyCommand command={site.installCmd} size="lg" />
        </div>
        <p class="mt-5 text-sm">
          <button
            type="button"
            data-copy={getStarted.prompt}
            class="link tap cursor-pointer"
          >
            <span data-copy-label>Copy a prompt for your agent</span>
          </button>
        </p>
      </div>
      <div class="min-w-0">
        <slot name="figure" />
      </div>
    </div>

    <p class="mt-14 text-[15px] text-ink-2 lg:mt-16">
      Works with {worksWith.slice(0, -1).join(', ')} and {worksWith.at(-1)}.
    </p>

    <ul class="mt-6 grid border-y border-rule md:grid-cols-3">
      {proofs.map((p, i) => (
        <li
          class:list={[
            'group relative flex flex-col gap-3 py-7 md:px-7 md:first:pl-0',
            i > 0 && 'border-t border-rule md:border-l md:border-t-0',
          ]}
        >
          <a
            href={p.href}
            target={external(p.href) ? '_blank' : undefined}
            rel={external(p.href) ? 'noopener noreferrer' : undefined}
            class="font-display text-[2.5rem] leading-none tabular-nums text-ink transition-colors duration-150 after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
          >
            {p.stat}<span class="sr-only"> ({p.hrefLabel}{external(p.href) && ', opens in new tab'})</span>
          </a>
          <p class="text-[15px] leading-6 text-ink-2">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
