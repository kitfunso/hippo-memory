---
import { site, proofs } from '../content/site';
import Terminal from './Terminal.astro';
import CopyCommand from './CopyCommand.astro';

const external = (href: string) => href.startsWith('http');
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10 hero-glow"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 dot-grid opacity-70"></div>

  <div class="mx-auto max-w-6xl px-5 pb-(--section-y) pt-10 sm:pt-14">
    <!-- DOM order is visual order at every width: words, then the session, then the proof strip. -->
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-6">
        <h1
          class="reveal text-balance text-[2.5rem] leading-(--leading-display) tracking-[-0.03em] sm:text-5xl lg:text-[3.25rem]"
          style="animation-delay: 60ms"
        >
          {site.tagline.lead} <span class="text-gradient">{site.tagline.accent}</span>
        </h1>

        <p class="reveal text-lg leading-relaxed text-zinc-300" style="animation-delay: 120ms">
          {site.tagline.summary}
        </p>

        <div class="reveal max-w-xl" style="animation-delay: 180ms">
          <CopyCommand command={site.installCmd} size="lg" />
        </div>
      </div>

      <figure class="reveal min-w-0" style="animation-delay: 200ms">
        <Terminal />
        <figcaption class="mt-3 text-balance text-center font-mono text-xs text-zinc-400">
          An illustrated session, with the hippo lines in the format hippo prints.
        </figcaption>
      </figure>
    </div>

    <ul class="reveal mt-16 grid border-y border-rule md:grid-cols-3" style="animation-delay: 280ms">
      {proofs.map((p, i) => (
        <li
          class:list={[
            'group relative flex flex-col gap-2 py-6 transition-colors hover:bg-white/[0.02] md:px-6',
            i > 0 && 'border-t border-rule md:border-t-0 md:border-l',
          ]}
        >
          <a
            href={p.href}
            target={external(p.href) ? '_blank' : undefined}
            rel={external(p.href) ? 'noopener noreferrer' : undefined}
            class:list={[
              'font-mono text-proof leading-tight tabular-nums after:absolute after:inset-0 after:content-[""]',
              p.tone === 'loss' ? 'text-warn' : 'text-zinc-100 group-hover:text-accent-light',
            ]}
          >
            {p.stat}<span class="sr-only"> ({p.hrefLabel}{external(p.href) && ', opens in new tab'})</span>
          </a>
          <p class="text-[15px] leading-6 text-zinc-400">{p.text}</p>
        </li>
      ))}
    </ul>
    <p class="reveal mt-4 font-mono text-xs text-zinc-400" style="animation-delay: 320ms">MIT, no account, no API key.</p>
  </div>
</section>
