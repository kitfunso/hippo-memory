---
import { site, proofs, worksWith, commands } from '../content/site';
import Terminal from './Terminal.astro';
import CopyCommand from './CopyCommand.astro';
import { getStats } from '../lib/stats';

const stats = await getStats(); // build-time social proof (cached + fallback)
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10 hero-glow"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 dot-grid opacity-70"></div>

  <div class="mx-auto max-w-6xl px-5 pb-(--section-y) pt-10 sm:pt-12">
    <!-- Terminal Native mockup: the pitch and install on the left, the session on the right. -->
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,32.5rem)_minmax(0,1fr)]">
      <div class="flex min-w-0 max-w-xl flex-col gap-6">
        <h1
          class="reveal text-balance text-[2.5rem] leading-[1.1] tracking-[-0.03em] sm:text-5xl lg:text-[3.25rem]"
          style="animation-delay: 60ms"
        >
          {site.tagline.lead}<br /><span class="text-gradient">{site.tagline.accent}</span>
        </h1>

        <p class="reveal text-lg leading-relaxed text-zinc-300" style="animation-delay: 120ms">
          {site.tagline.summary}
        </p>

        <div class="reveal" style="animation-delay: 180ms">
          <CopyCommand command={site.installCmd} size="lg" />
          <ul aria-label="Works with" class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-zinc-400">
            {worksWith.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>

        <ul class="reveal max-w-(--measure) space-y-2 text-sm leading-6 text-zinc-400" style="animation-delay: 240ms">
          {proofs.map((p) => (
            <li>
              {'href' in p && p.href ? (
                <a class="link font-medium tabular-nums" href={p.href} target="_blank" rel="noopener noreferrer">
                  {p.stat}<span class="sr-only"> ({p.hrefLabel}, opens in new tab)</span>
                </a>
              ) : (
                <span class="font-medium text-zinc-200 tabular-nums">{p.stat}</span>
              )}{' '}{p.text}
            </li>
          ))}
        </ul>

        <p class="reveal flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-400" style="animation-delay: 280ms">
          <a href={site.links.repo} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-100">
            <span class="font-medium text-zinc-200 tabular-nums">{stats.starsLabel}</span> stars
          </a>
          <span aria-hidden="true" class="text-zinc-600">·</span>
          <a href={site.links.npm} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-100">
            <span class="font-medium text-zinc-200 tabular-nums">{stats.downloadsLabel}</span> downloads
          </a>
          <span aria-hidden="true" class="text-zinc-600">·</span>
          <a href={site.links.atlas} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-100">
            compared in the agent-memory-atlas
          </a>
        </p>
      </div>

      <div class="reveal min-w-0" style="animation-delay: 200ms">
        <Terminal />
        <p class="mt-3 text-balance text-center font-mono text-xs text-zinc-400">an illustrated session · the hippo lines are real hippo output</p>
      </div>
    </div>

    <ul class="reveal mt-16 grid gap-px overflow-hidden rounded-xl border border-zinc-800 bg-zinc-800 md:grid-cols-3" style="animation-delay: 320ms">
      {commands.map((c) => (
        <li class="flex flex-col gap-2 bg-zinc-950 p-6">
          <code class="font-mono text-[13px] text-acc-violet">{c.cmd}</code>
          <p class="text-[15px] leading-6 text-zinc-300">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
