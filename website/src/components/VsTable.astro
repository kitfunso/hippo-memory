---
// Hippo against one system, on the rows a page picks from the README comparison table, so a vs page cannot drift from it.
import { comparison } from '../content/site';

interface Props {
  system: string;
  // [README row label, label shown on the page]
  rows: ReadonlyArray<readonly [string, string]>;
}
const { system, rows: picks } = Astro.props;
const col = comparison.systems.findIndex((s) => s.name === system);
if (col < 0) throw new Error(`README comparison has no "${system}" column`);
const them = comparison.systems[col];
const rows = picks.map(([label, shown]) => {
  const r = comparison.rows.find((x) => x.feature === label);
  if (!r) throw new Error(`README comparison has no row "${label}"`);
  return { feature: shown, hippo: r.cells[0], them: r.cells[col] };
});
---

<div class="overflow-hidden rounded-xl border border-rule">
  <!-- Fixed equal columns: the rival's column is the point of a vs page, so it never scrolls off a phone. -->
  <table class="w-full table-fixed text-left text-[13px] leading-snug sm:text-sm">
    <caption class="sr-only">hippo and {them.name}, selected rows of the README comparison table</caption>
    <colgroup><col class="w-[30%]" /><col class="w-[35%]" /><col class="w-[35%]" /></colgroup>
    <thead class="border-b border-rule-strong text-xs text-ink-3">
      <tr>
        <th scope="col" class="px-3 py-3 font-medium sm:px-5">Feature</th>
        <th scope="col" class="px-3 py-3 font-medium text-ink sm:px-5">hippo</th>
        <th scope="col" class="px-3 py-3 font-medium [overflow-wrap:anywhere] sm:px-5">{them.name}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule">
      {rows.map((r) => (
        <tr class="align-top text-ink-2">
          <th scope="row" class="px-3 py-3 text-left font-normal text-ink-2 hyphens-auto [overflow-wrap:anywhere] sm:px-5">{r.feature}</th>
          <td class="px-3 py-3 font-medium text-ink [overflow-wrap:anywhere] sm:px-5">{r.hippo}</td>
          <td class="px-3 py-3 [overflow-wrap:anywhere] sm:px-5">{r.them}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
