---
import { site } from '../content/site';

const groups = [
  {
    label: 'Agents',
    links: [
      { label: 'Claude Code', href: '/claude-code/' },
      { label: 'Cursor', href: '/cursor/' },
      { label: 'Codex', href: '/codex/' },
      { label: 'MCP server', href: '/mcp/' },
    ],
  },
  {
    label: 'Compare',
    links: [
      { label: 'hippo vs mem0', href: '/vs/mem0/' },
      { label: 'hippo vs Zep', href: '/vs/zep/' },
      { label: 'hippo vs Letta', href: '/vs/letta/' },
      { label: 'CLAUDE.md vs memory', href: '/vs/claude-memory/' },
    ],
  },
  {
    label: 'Site',
    links: [
      { label: 'Quickstart', href: '/quickstart/' },
      { label: 'How it works', href: '/how-it-works/' },
      { label: 'Benchmarks', href: '/benchmarks/' },
      { label: 'Teams', href: '/teams/' },
      { label: 'FAQ', href: '/faq/' },
    ],
  },
  {
    label: 'Resources',
    external: true,
    links: [
      { label: 'GitHub', href: site.links.repo },
      { label: 'npm', href: site.links.npm },
      { label: 'Docs', href: site.links.docs },
      { label: 'Changelog', href: site.links.changelog },
      { label: 'Licence (MIT)', href: site.links.license },
    ],
  },
];
---

<footer class="border-t border-rule bg-paper-3">
  <div class="wrap pb-10 pt-14">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <p class="font-display text-[1.375rem] leading-none text-ink">hippo</p>
      <div class="grid grid-cols-2 gap-x-12 gap-y-10 md:grid-cols-4">
        {groups.map((g) => (
          <nav aria-labelledby={`footer-${g.label.toLowerCase()}`} class="flex flex-col items-start gap-1 text-sm">
            <p id={`footer-${g.label.toLowerCase()}`} class="mb-2 font-medium text-ink">{g.label}</p>
            {g.links.map((l) => (
              <a
                href={l.href}
                target={g.external ? '_blank' : undefined}
                rel={g.external ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-8 items-center text-ink-2 transition-colors duration-150 hover:text-ink"
              >{l.label}</a>
            ))}
          </nav>
        ))}
      </div>
    </div>
    <p class="mt-14 border-t border-rule pt-6 font-mono text-xs text-ink-3">hippo-memory v{site.version}, MIT, built by kitfunso</p>
  </div>
</footer>
