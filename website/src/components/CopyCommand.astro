---
interface Props {
  command: string;
  size?: 'sm' | 'lg';
}
const { command, size = 'sm' } = Astro.props;
// 14px like the mockup's command box, so the install line fits one row on a 390px phone.
const pad = size === 'lg' ? 'px-4 py-4 text-sm sm:px-5' : 'px-4 py-3 text-sm';
---

<div class:list={['group flex items-center gap-3 rounded-xl glass font-mono', pad]}>
  <span class="select-none text-acc-cyan">$</span>
  <!-- each word is an inline-block: lines break between words, and inside one (hippo-memory at its hyphen) only when it cannot fit a line alone -->
  <code class="min-w-0 flex-1 break-words text-zinc-200">{command.split(' ').map((word, i) => <Fragment>{i > 0 && ' '}<span class="inline-block max-w-full">{word}</span></Fragment>)}</code>
  <button
    type="button"
    data-copy={command}
    aria-label={`Copy command: ${command}`}
    class="relative shrink-0 rounded-md border border-white/10 px-3 py-1.5 text-xs text-zinc-400 transition after:absolute after:-inset-2 after:content-[''] hover:border-acc-violet/50 hover:text-zinc-100 focus-visible:text-zinc-100"
  >
    <span data-copy-label>Copy</span>
  </button>
</div>
