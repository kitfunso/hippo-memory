---
import { receipts } from '../content/site';
import RepeatMistakes from './RepeatMistakes.astro';
---

<section id="receipts" class="relative border-t border-white/5 bg-white/[0.02]">
  <div class="mx-auto max-w-6xl px-5 py-(--section-y)">
    <div class="max-w-xl">
      <h2 class="text-3xl leading-tight sm:text-4xl">Numbers, including the losses.</h2>
    </div>

    <div class="mt-10">
      <RepeatMistakes />
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {receipts.map((r) => (
        <a
          href={r.href}
          target="_blank"
          rel="noopener noreferrer"
          class="glass glass-hover group flex flex-col rounded-2xl p-6"
          data-reveal
        >
          <span class:list={['font-mono text-[clamp(1.75rem,8vw,3rem)] font-medium tracking-tight', 'tone' in r && r.tone === 'loss' ? 'text-warn' : 'text-gradient']}>{r.stat}</span>
          <span class="mt-3 text-sm font-medium text-zinc-200">{r.label}</span>
          <span class="mt-2 text-xs leading-relaxed text-zinc-400">{r.note}</span>
          <span class="mt-4 inline-flex items-center gap-1 font-mono text-xs text-zinc-400 transition group-hover:text-accent-light">
            source ↗
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
