---
// One half of the local and compare pair; the empty span keeps the old #local-first anchor working.
import { localFirst } from '../content/site';
import { mdInline } from '../content/readme';
---

<div id="local" class="min-w-0">
  <span id="local-first" aria-hidden="true"></span>
  <h2>{localFirst.heading}</h2>
  <p class="copy mt-5 leading-relaxed text-ink-2" set:html={mdInline(localFirst.body)} />
</div>
