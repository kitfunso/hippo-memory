---
import { localFirst } from '../content/site';
import { mdInline } from '../content/readme';
import Section from './Section.astro';
---

<!-- The empty span keeps the old #local-first anchor working. -->
<span id="local-first" aria-hidden="true"></span>
<Section title={localFirst.heading} id="local" split>
  <p set:html={mdInline(localFirst.body)} />
</Section>
