{
  "name": "hippo-memory",
  "version": "1.45.0",
  "description": "Biologically-inspired memory for AI agents. Zero runtime deps, SQLite, MCP server, and an opt-in hosted TypeSafe Jev reranker. Decay, retrieval strengthening, consolidation.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./extensions/openclaw-plugin/index.ts"
    ]
  },
  "bin": {
    "hippo": "bin/hippo.js"
  },
  "files": [
    "dist",
    "!dist/src",
    "!dist/**/*.map",
    "dist-ui",
    "bin",
    "scripts/postinstall.cjs",
    "openclaw.plugin.json",
    "extensions/openclaw-plugin"
  ],
  "scripts": {
    "baseline": "npm run build && npm test",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc -p tsconfig.benchmarks.json && tsc -p tsconfig.extensions.json",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "audit:security": "npm audit --audit-level=high && npm --prefix ui audit --audit-level=high",
    "postinstall": "node scripts/postinstall.cjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:openclaw-install": "node scripts/smoke-openclaw-install.mjs",
    "build:ui": "cd ui && npm install && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "version": "node scripts/sync-version.mjs && node scripts/check-manifest-versions.mjs",
    "prepublishOnly": "node scripts/check-manifest-versions.mjs && node scripts/changelog-fragments.mjs check && node scripts/check-em-dashes-in-release-notes.mjs && node scripts/check-graph-writes.mjs && npm run build:all && node scripts/check-openclaw-dist.mjs && npm run smoke:openclaw-install && node scripts/check-tests-pass.mjs"
  },
  "keywords": [
    "memory",
    "ai",
    "agents",
    "llm",
    "claude",
    "context",
    "recall",
    "episodic",
    "semantic",
    "embeddings",
    "hybrid-search",
    "agent-memory",
    "long-term-memory",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "rag",
    "retrieval",
    "sqlite",
    "cli",
    "typescript"
  ],
  "author": "Keith",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitfunso/hippo-memory.git"
  },
  "homepage": "https://hippo-memory.com",
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^22.16.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "overrides": {
    "protobufjs": "7.6.4"
  }
}
