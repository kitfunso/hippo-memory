{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".context/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".hippo/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "docs/brand/**",
    "dist-bench/**",
    "dist-ui/**",
    "ui/dist/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "boundaries", "specifier": "./tools/oxlint/boundaries/index.mjs" }
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "curly": ["error", "multi-line"],
    "no-useless-concat": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "import/no-cycle": ["error", { "ignoreTypes": true }],
        "anti-slop/require-safety-comment-for-type-assertion": ["error", { "allowStatementReads": true }],
        "max-params": ["error", { "max": 5 }],
        "boundaries/max-signature-params": "error",
        "max-lines-per-function": ["error", { "max": 50 }],
        "max-lines": ["error", { "max": 800 }],
        "id-denylist": ["error", "sqliteStoreOn"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." }
        ]
      }
    },
    {
      "files": ["src/api/**/*.ts", "src/domain/**/*.ts"],
      "rules": { "boundaries/no-adapter-name": "error" }
    },
    {
      "files": ["src/api/**/*.ts"],
      "rules": {
        "id-denylist": ["error", "sqliteStoreOn", "hippoRoot"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "property": "hippoRoot", "message": "The api reads what the folder gave from a port method." }
        ]
      }
    },
    {
      "files": ["src/surface/server/routes/**/*.ts"],
      "rules": {
        "id-denylist": ["error", "sqliteStoreOn", "requireGroup"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "property": "requireGroup", "message": "A route calls a src/api function that takes the Context." }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(ports/store|ports/store-index|entry/store-kit)[.]js$",
                "importNames": ["requireGroup"],
                "message": "A route calls a src/api function that takes the Context."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/store/sqlite/**/*.ts", "src/surface/open-store.ts"],
      "rules": { "id-denylist": "off", "no-restricted-properties": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": { "max-lines-per-function": ["error", { "max": 80 }], "max-lines": ["error", { "max": 800 }] }
    },
    {
      "files": ["tests/**/*.test.ts"],
      "rules": { "max-lines": ["error", { "max": 800 }] }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": ["error", { "allowStatementReads": true }] }
    },
    { "files": ["deploy/**/*.mjs"], "rules": { "anti-slop/no-runtime-typeof": "off" } },
    {
      "files": [
        "scripts/z1-replay.mjs",
        "scripts/e1-lifecycle/**",
        "scripts/z6-supersession/**",
        "scripts/token-eval/**",
        "benchmarks/**"
      ],
      "rules": { "curly": "off" }
    },
    {
      "files": [
        "scripts/z1-replay.mjs",
        "scripts/z1c-eval.mjs",
        "scripts/z0-capture-eval.mjs",
        "scripts/e1-lifecycle/generate.mjs",
        "tests/eval/token-eval-z0-homes.test.ts"
      ],
      "rules": { "max-lines": "off", "max-lines-per-function": "off" }
    }
  ]
}
