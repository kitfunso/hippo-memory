{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".context/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".hippo/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "docs/brand/**",
    "dist-bench/**",
    "dist-ui/**",
    "ui/dist/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "boundaries", "specifier": "./tools/oxlint/boundaries/index.mjs" }
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "curly": ["error", "multi-line"],
    "no-useless-concat": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "import/no-cycle": ["error", { "ignoreTypes": true }],
        "anti-slop/require-safety-comment-for-type-assertion": ["error", { "allowStatementReads": true }],
        "max-params": ["error", { "max": 5 }],
        "boundaries/max-signature-params": "error",
        "max-lines-per-function": ["error", { "max": 50 }],
        "max-lines": ["error", { "max": 800 }],
        "id-denylist": ["error", "sqliteStoreOn"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." }
        ],
        "unicorn/no-process-exit": "error",
        "boundaries/no-hand-transaction": "error",
        "boundaries/no-twin-function": "error"
      }
    },
    {
      "files": ["src/db/**/*.ts", "src/store/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." }
        ]
      }
    },
    {
      "files": ["src/store/sqlite/**/*.ts"],
      "rules": {
        "id-denylist": "off",
        "no-restricted-properties": [
          "error",
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." }
        ]
      }
    },
    {
      "files": ["src/base/util/env.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." }
        ]
      }
    },
    {
      "files": ["src/host/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "config-file[.]js$",
                "importNames": ["loadConfig"],
                "message": "Only the surface reads config.json; host code takes a ConfigReader."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/**/*.ts", "src/domain/**/*.ts"],
      "rules": { "boundaries/no-adapter-name": "error" }
    },
    {
      "files": ["src/api/**/*.ts"],
      "rules": {
        "id-denylist": [
          "error",
          "sqliteStoreOn",
          "hippoRoot",
          "requireGroup",
          "hasGroup",
          "requireGroups",
          "hasGroups",
          "HippoStore"
        ],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "property": "hippoRoot", "message": "The api reads what the folder gave from a port method." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "requireGroup", "message": "Groups are bound at boot; api code uses the store it is given." },
          { "property": "hasGroup", "message": "Groups are bound at boot; api code uses the store it is given." },
          { "property": "requireGroups", "message": "Groups are bound at boot; api code uses the store it is given." },
          { "property": "hasGroups", "message": "Groups are bound at boot; api code uses the store it is given." }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^[.]",
                "importNames": ["requireGroup", "hasGroup", "requireGroups", "hasGroups", "HippoStore"],
                "message": "Groups are bound at boot; api code uses the store it is given. Name the groups with RequiredStore, StoreWith or ContextWith."
              }
            ]
          }
        ],
        "boundaries/no-store-branch": "error"
      }
    },
    {
      "files": ["src/domain/**/*.ts"],
      "rules": {
        "id-denylist": ["error", "sqliteStoreOn", "requireGroup", "hasGroup", "requireGroups", "hasGroups", "HippoStore"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "requireGroup", "message": "Groups are bound at boot; domain code uses the store it is given." },
          { "property": "hasGroup", "message": "Groups are bound at boot; domain code uses the store it is given." },
          { "property": "requireGroups", "message": "Groups are bound at boot; domain code uses the store it is given." },
          { "property": "hasGroups", "message": "Groups are bound at boot; domain code uses the store it is given." },
          { "object": "globalThis", "property": "fetch", "message": "Domain code reaches the network through a port." }
        ],
        "no-restricted-globals": ["error", { "name": "fetch", "message": "Domain code reaches the network through a port." }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(http-retry|embedding-provider|embeddings/provider|local-embedder|transformers)([.][cm]?[jt]s)?$",
                "message": "Domain code reaches a model or the network through a port that src/infra implements."
              },
              {
                "regex": "^[.]",
                "importNames": ["fetchWithRetry", "resolveEmbeddingProvider", "importTransformers"],
                "message": "Domain code reaches a model or the network through a port that src/infra implements."
              },
              {
                "regex": "^[.]",
                "importNames": ["requireGroup", "hasGroup", "requireGroups", "hasGroups", "HippoStore"],
                "message": "Groups are bound at boot; domain code uses the store it is given. Name the groups with RequiredStore, StoreWith or ContextWith."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/surface/**/*.ts", "src/cli.ts"],
      "rules": {
        "id-denylist": ["error", "sqliteStoreOn", "bumpRecallStats", "noteRecall", "lastShown"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "bumpRecallStats", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "noteRecall", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "lastShown", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." }
        ],
        "boundaries/no-recall-ledger-label": "error"
      }
    },
    {
      "files": ["src/surface/cli/**/*.ts", "src/cli.ts"],
      "rules": {
        "id-denylist": [
          "error",
          "sqliteStoreOn",
          "bumpRecallStats",
          "noteRecall",
          "lastShown",
          "rankRecall",
          "resolveTenantId",
          "finishRecall",
          "writeEntry"
        ],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "bumpRecallStats", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "noteRecall", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "lastShown", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "finishRecall", "message": "The CLI recalls through retrieveWithCliCore(), which writes every recall row." },
          { "property": "writeEntry", "message": "A CLI verb changes rows through a src/api function that takes the Context." }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "api/recall/pipeline[.]js$",
                "importNames": ["rankRecall"],
                "message": "The CLI ranks a recall through retrieveWithCliCore() in src/api/recall/request.ts."
              },
              {
                "regex": "(server/boot|entry/testing)[.]js$",
                "importNames": ["resolveTenantId"],
                "message": "The CLI resolves its tenant once, at dispatch, and hands it down."
              }
            ]
          }
        ],
        "boundaries/no-hand-flag-read": "error",
        "boundaries/no-hand-fail": "error"
      }
    },
    {
      "files": ["src/surface/cli/recall.ts", "src/surface/cli/explain.ts"],
      "rules": {
        "id-denylist": [
          "error",
          "sqliteStoreOn",
          "bumpRecallStats",
          "noteRecall",
          "lastShown",
          "rankRecall",
          "resolveTenantId",
          "finishRecall",
          "writeEntry",
          "recordTokens"
        ],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "bumpRecallStats", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "noteRecall", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "lastShown", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "finishRecall", "message": "The CLI recalls through retrieveWithCliCore(), which writes every recall row." },
          { "property": "writeEntry", "message": "A CLI verb changes rows through a src/api function that takes the Context." },
          { "property": "recordTokens", "message": "retrieveWithCliCore() books the recall's token row." }
        ]
      }
    },
    {
      "files": ["src/surface/cli/exit.ts"],
      "rules": { "boundaries/no-hand-fail": "off" }
    },
    {
      "files": ["src/surface/server/routes/**/*.ts"],
      "rules": {
        "id-denylist": ["error", "sqliteStoreOn", "bumpRecallStats", "noteRecall", "lastShown", "requireGroup"],
        "no-restricted-properties": [
          "error",
          { "property": "sqliteStoreOn", "message": "Take the store from a composition root." },
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "bumpRecallStats", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "noteRecall", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "lastShown", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "requireGroup", "message": "A route calls a src/api function that takes the Context." }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(ports/store|ports/store-index|entry/store-kit)[.]js$",
                "importNames": ["requireGroup"],
                "message": "A route calls a src/api function that takes the Context."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/surface/open-store.ts"],
      "rules": {
        "id-denylist": "off",
        "no-restricted-properties": [
          "error",
          { "object": "process", "property": "env", "message": "Read the environment through src/base/util/env.ts." },
          { "object": "globalThis", "property": "process", "message": "Name the process global, so the env rule sees it." },
          { "property": "prepare", "message": "SQL runs in src/db and src/store; reach the database through the port." },
          { "property": "bumpRecallStats", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "noteRecall", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." },
          { "property": "lastShown", "message": "Pass recordAs to retrieve(); src/api/recall/finish.ts records it." }
        ]
      }
    },
    {
      "files": ["src/db/busy.ts"],
      "rules": { "boundaries/no-hand-transaction": "off" }
    },
    {
      "files": [
        "src/base/util/crash-handlers.ts",
        "src/surface/server/sleep-child.ts",
        "src/surface/cli/hooks/codex-run.ts"
      ],
      "rules": { "unicorn/no-process-exit": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": { "max-lines-per-function": ["error", { "max": 80 }], "max-lines": ["error", { "max": 800 }] }
    },
    {
      "files": ["tests/**/*.test.ts"],
      "rules": { "max-lines": ["error", { "max": 800 }] }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": ["error", { "allowStatementReads": true }] }
    },
    {
      "files": ["tests/**"],
      "rules": { "boundaries/no-env-write": "error" }
    },
    {
      "files": ["tests/**/_helpers/**"],
      "rules": { "boundaries/no-env-write": "off" }
    },
    { "files": ["deploy/**/*.mjs"], "rules": { "anti-slop/no-runtime-typeof": "off" } },
    {
      "files": [
        "scripts/z1-replay.mjs",
        "scripts/e1-lifecycle/**",
        "scripts/z6-supersession/**",
        "scripts/token-eval/**",
        "benchmarks/**"
      ],
      "rules": { "curly": "off" }
    },
    {
      "files": [
        "scripts/z1-replay.mjs",
        "scripts/z1c-eval.mjs",
        "scripts/z0-capture-eval.mjs",
        "scripts/e1-lifecycle/generate.mjs",
        "tests/eval/token-eval-z0-homes.test.ts"
      ],
      "rules": { "max-lines": "off", "max-lines-per-function": "off" }
    }
  ]
}
