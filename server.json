{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kitfunso/hippo-memory",
  "title": "Hippo memory",
  "description": "Memory for AI agents that learns what is wrong and ranks it down. Local SQLite store.",
  "version": "1.52.8",
  "websiteUrl": "https://hippo-memory.com",
  "repository": {
    "url": "https://github.com/kitfunso/hippo-memory",
